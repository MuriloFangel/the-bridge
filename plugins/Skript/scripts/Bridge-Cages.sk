# ================================================================
# THE BRIDGE - CAGES FÍSICAS / DIMENSÕES POR TIME E EIXO
# Preserva cor, snapshots e restauração. Sem eventos ou timers próprios.
# ================================================================

import:
    org.bukkit.Material

# ---------------------------------------------------------
# CONSTRUTOR E REMOVEDOR DE CAGES FÍSICAS
# ---------------------------------------------------------
function bridge_buildCage(center: location, colorData: integer, inst: text):
    set {_w} to world of {_center}
    set {_cx} to floor(x-coordinate of {_center})
    set {_cy} to floor(y-coordinate of {_center})
    set {_cz} to floor(z-coordinate of {_center})
    set {_minY} to {_cy} - 1
    set {_maxY} to {_cy} + 3
    # Identifica o lado pela referência exata usada por Rounds/Voting.
    # Não usa cor como identidade do time nem modifica os chamadores existentes.
    set {_arena} to {bridge::instance::%{_inst}%::arena}
    set {_team} to 0
    loop 2 times:
        set {_t} to loop-value
        delete {_origin}
        set {_origin} to {bridge::arena::%{_arena}%::team::%{_t}%::cage}
        if {_origin} is not set:
            set {_spawn} to {bridge::arena::%{_arena}%::team::%{_t}%::sponge}
            if {_spawn} is set:
                set {_origin} to location 7 blocks above {_spawn}
        if {_origin} is set:
            set {_anchor} to bridge_getLoc({_origin}, {_inst})
            if world of {_anchor} is world of {_center}:
                if distance between {_anchor} and {_center} < 0.01:
                    if {_team} is not 0:
                        send "[Bridge] ERRO: referências de cages sobrepostas em %{_inst}%." to console
                        stop
                    set {_team} to {_t}
    if {_team} is 0:
        send "[Bridge] ERRO: lado da cage não identificado em %{_inst}%." to console
        stop
    set {_count} to size of {bridge::instance::%{_inst}%::team::%{_team}%::players::*}
    if {_count} < 1:
        set {_count} to 1
    set {_width} to (ceil({_count} / 2) * 2) + 1
    set {_lateralRadius} to ({_width} + 1) / 2
    set {_rx} to 2
    set {_rz} to 2
    if {bridge::arena::%{_arena}%::axis} is "X":
        set {_rz} to {_lateralRadius}
    else if {bridge::arena::%{_arena}%::axis} is "Z":
        set {_rx} to {_lateralRadius}
    else:
        send "[Bridge] ERRO: eixo inválido para cage em %{_inst}%." to console
        stop
    set {_minX} to {_cx} - {_rx}
    set {_maxX} to {_cx} + {_rx}
    set {_minZ} to {_cz} - {_rz}
    set {_maxZ} to {_cz} + {_rz}
    set {_sizeX} to ({_rx} * 2) + 1
    set {_sizeZ} to ({_rz} * 2) + 1
    set {_expected} to ({_sizeX} * 5 * {_sizeZ}) - (({_sizeX} - 2) * 3 * ({_sizeZ} - 2))
    set {_checked} to 0
    set {_failed} to 0

    loop 5 times:
        set {_y} to {_minY} + loop-value - 1
        loop {_sizeX} times:
            set {_x} to {_minX} + loop-value-2 - 1
            loop {_sizeZ} times:
                set {_z} to {_minZ} + loop-value-3 - 1
                set {_outer} to false
                if {_y} is {_minY}:
                    set {_outer} to true
                if {_y} is {_maxY}:
                    set {_outer} to true
                if {_x} is {_minX}:
                    set {_outer} to true
                if {_x} is {_maxX}:
                    set {_outer} to true
                if {_z} is {_minZ}:
                    set {_outer} to true
                if {_z} is {_maxZ}:
                    set {_outer} to true
                if {_outer} is true:
                    set {_loc} to location at {_x}, {_y}, {_z} in {_w}
                    set {_key} to "%{_x}%,%{_y}%,%{_z}%"
                    set {_b} to {_loc}.getBlock()
                    if {bridge::instance::%{_inst}%::cage_blocks::*} does not contain {_loc}:
                        set {-bridge::cage_snapshot::%{_inst}%::%{_key}%} to {_b}.getState()
                        add {_loc} to {bridge::instance::%{_inst}%::cage_blocks::*}
                    {_b}.setType(Material.STAINED_GLASS, false)
                    {_b}.setData({_colorData}, false)
                    add 1 to {_checked}
                    if {_b}.getType().getId() is not 95:
                        add 1 to {_failed}
                    else if {_b}.getData() is not {_colorData}:
                        add 1 to {_failed}
    if {_checked} is not {_expected}:
        send "[Bridge] ERRO: cage %{_inst}% em %{_center}%: %{_checked}% posições; esperado %{_expected}%." to console
    if {_failed} > 0:
        send "[Bridge] ERRO: cage %{_inst}% em %{_center}%: %{_failed}% blocos de vidro falharam. Verifique teto, piso e paredes." to console
        bridge_chatInstance({_inst}, "&cFalha na montagem da cage. Avise a administração; não tente sair pelo vão.")

function bridge_removeCage(inst: text):
    loop {bridge::instance::%{_inst}%::cage_blocks::*}:
        set {_loc} to loop-value
        set {_x} to floor(x-coordinate of {_loc})
        set {_y} to floor(y-coordinate of {_loc})
        set {_z} to floor(z-coordinate of {_loc})
        set {_key} to "%{_x}%,%{_y}%,%{_z}%"
        set {_saved} to {-bridge::cage_snapshot::%{_inst}%::%{_key}%}
        if {_saved} is set:
            set {_restored} to {_saved}.update(true, false)
            if {_restored} is false:
                send "[Bridge] ERRO: falha ao restaurar bloco temporário de cage em %{_loc}% (%{_inst}%)." to console
        else:
            # Compatibilidade com registros de cage da versão anterior (somente ar).
            set {_b} to {_loc}.getBlock()
            if {_b}.getType().getId() is 95:
                {_b}.setType(Material.AIR, false)
    delete {bridge::instance::%{_inst}%::cage_blocks::*}
    delete {-bridge::cage_snapshot::%{_inst}%::*}

