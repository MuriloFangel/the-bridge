# ================================================================
# THE BRIDGE - GAMEPLAY / COMBATE, RESPAWN, ITENS E CONSTRUÇÃO
# Fechamento 1 parcial: correções de combate, vida e resultado; ver manifesto.
# Requer o conjunto de módulos Bridge existente; não é um script independente.
# Revisão estática não certifica carregamento nem gameplay.
# ================================================================

import:
    org.bukkit.util.Vector
    org.bukkit.event.entity.EntityDamageByEntityEvent as BridgeDamageByEntityEvent
    org.bukkit.event.entity.ProjectileLaunchEvent as BridgeArrowLaunchEvent

on hunger meter change:
    set food level to 20

on heal:
    if {bridge::player::%player's uuid%::state} is "INGAME":
        set {_reason} to "%heal cause%"
        if {_reason} contains "satiated" or "natural" or "regen":
            cancel event

function bridge_respawnPlayer(p: player, deathType: text = "VOID", killerName: text = ""):
    set {_inst} to {bridge::player::%{_p}'s uuid%::instance}
    if {_inst} is not set:
        stop
    if bridge_isPresent({_p}, {_inst}) is not true:
        stop
    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        stop
    if bridge_pauseActionsBlocked({_inst}) is true:
        stop
    if {_killerName} is not "":
        set {_validated} to bridge_validTagName({_p})
        if {_validated} is not {_killerName}:
            set {_killerName} to ""
            if {_deathType} is "VOID_KILL":
                set {_deathType} to "VOID"
    set {_arena} to {bridge::instance::%{_inst}%::arena}
    set {_team} to {bridge::player::%{_p}'s uuid%::team}
    set {_orig} to {bridge::arena::%{_arena}%::team::%{_team}%::sponge}
    set {_dest} to bridge_getLoc({_orig}, {_inst})
    
    set {_vNameFormatted} to bridge_getFormattedPlayerName({_p})

    if {_deathType} is not "SELF_PORTAL":
        bridge_addStat({_p}, "deaths", 1)
        if {_killerName} is not "":
            set {_pKiller} to {_killerName} parsed as offline player
            if {_pKiller} is online:
                bridge_addStat({_pKiller}, "kills", 1)
                add 1 to {bridge::player::%{_pKiller}'s uuid%::match_kills}

    if {_killerName} is not "":
        set {_pKillerObj} to {_killerName} parsed as offline player
        if {_pKillerObj} is online:
            set {_kNameFormatted} to bridge_getFormattedPlayerName({_pKillerObj})
        else:
            set {_kNameFormatted} to "&f%{_killerName}%"

        if {_deathType} is "VOID_KILL":
            set {_msg} to "%{bridge::config::prefix}% %{_vNameFormatted}% &7foi jogado no void por %{_kNameFormatted}%&7!"
        else:
            set {_msg} to "%{bridge::config::prefix}% %{_vNameFormatted}% &7foi abatido por %{_kNameFormatted}%&7!"
    else if {_deathType} is "SELF_PORTAL":
        set {_msg} to "%{bridge::config::prefix}% %{_vNameFormatted}% &erenasceu no próprio portal!"
    else:
        set {_msg} to "%{bridge::config::prefix}% %{_vNameFormatted}% &7caiu no void e renasceu!"

    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            send {_msg} to loop-value
    loop {bridge::instance::%{_inst}%::team::2::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            send {_msg} to loop-value

    teleport {_p} to {_dest}
    bridge_giveKit({_p}, {bridge::arena::%{_arena}%::team::%{_team}%::color})
    
    delete {-bridge::player::%{_p}'s uuid%::last_attacker_name}
    delete {-bridge::player::%{_p}'s uuid%::last_attacker_time}

    set {_zero} to new Vector(0, 0, 0)
    {_p}.setVelocity({_zero})

on player move:
    if {bridge::player::%player's uuid%::state} is not "INGAME":
        stop
    set {_inst} to {bridge::player::%player's uuid%::instance}
    if {_inst} is not set:
        stop
    if bridge_isPresent(player, {_inst}) is not true:
        stop
    if bridge_pauseItemsBlocked({_inst}) is true:
        cancel event
        stop
    if bridge_pauseActionsBlocked({_inst}) is true:
        stop
    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        stop
    set {_arena} to {bridge::instance::%{_inst}%::arena}
    if y-coordinate of player < {bridge::arena::%{_arena}%::y-void}:
        set {_killer} to bridge_validTagName(player)
        if {_killer} is "":
            bridge_respawnPlayer(player, "VOID", "")
        else:
            bridge_respawnPlayer(player, "VOID_KILL", {_killer})
        stop
    set {_team} to {bridge::player::%player's uuid%::team}
    loop {bridge::arena::%{_arena}%::team::%{_team}%::portals::*}:
        set {_ownPortal} to bridge_getLoc(loop-value, {_inst})
        if world of player is world of {_ownPortal}:
            if distance between location of player and {_ownPortal} <= 2.2:
                set {_killer} to bridge_validTagName(player)
                if {_killer} is "":
                    bridge_respawnPlayer(player, "SELF_PORTAL", "")
                else:
                    bridge_respawnPlayer(player, "VOID_KILL", {_killer})
                stop
    set {_enemy} to 1
    if {_team} is 1:
        set {_enemy} to 2
    loop {bridge::arena::%{_arena}%::team::%{_enemy}%::portals::*}:
        set {_goalLoc} to bridge_getLoc(loop-value, {_inst})
        if world of player is world of {_goalLoc}:
            if distance between location of player and {_goalLoc} <= 2.2:
                bridge_scoreGoal({_inst}, player, {_team})
                stop

on right click:
    set {_inst} to {bridge::player::%player's uuid%::instance}
    if {_inst} is set:
        if bridge_pauseItemsBlocked({_inst}) is true:
            cancel event
            stop
        if {bridge::instance::%{_inst}%::in_pause} is true:
            if player's tool is not golden apple:
                if player's tool is not bow:
                    cancel event

on consume of golden apple:
    if {bridge::player::%player's uuid%::state} is "INGAME":
        set {_gInst} to {bridge::player::%player's uuid%::instance}
        if bridge_pauseItemsBlocked({_gInst}) is true:
            cancel event
            stop
        cancel event
        remove 1 golden apple from player's inventory
        player.setHealth(20.0)
        
        if {bridge::player::%player's uuid%::gapple_eaten} is not set:
            set {bridge::player::%player's uuid%::gapple_eaten} to true
            apply absorption 1 to player for 999 minutes
            send "%{bridge::config::prefix}% &eMaçã consumida &8| &7Vida restaurada e absorção inicial concedida." to player
        else:
            send "%{bridge::config::prefix}% &eMaçã consumida &8| &7Vida restaurada; sem nova absorção nesta vida." to player

on BridgeArrowLaunchEvent with priority highest:
    if event.isCancelled() is true:
        stop
    set {_arrow} to event.getEntity()
    if {_arrow}.getType().name() is not "ARROW":
        stop
    set {_p} to {_arrow}.getShooter()
    if {_p} is not a player:
        stop
    set {_u} to {_p}'s uuid
    set {_inst} to {bridge::player::%{_u}%::instance}
    if {_inst} is not set:
        stop
    if bridge_isPresent({_p}, {_inst}) is not true:
        cancel event
        stop
    if bridge_pauseActionsBlocked({_inst}) is true:
        cancel event
        stop
    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        cancel event
        stop
    set {_sid} to {bridge::instance::%{_inst}%::match_id}
    set {_life} to {bridge::player::%{_u}%::life_id}
    if {_sid} is not set:
        cancel event
        stop
    if {_life} is not set:
        cancel event
        stop
    set {_id} to {_arrow}.getUniqueId().toString()
    set {-bridge::arrows::%{_id}%::instance} to {_inst}
    set {-bridge::arrows::%{_id}%::match_id} to {_sid}
    set {-bridge::arrows::%{_id}%::shooter} to {_u}
    set {-bridge::arrow_entities::%{_id}%} to {_arrow}
    wait 3.5 seconds
    if {_p} is not online:
        stop
    if bridge_isPresent({_p}, {_inst}) is not true:
        stop
    if {bridge::instance::%{_inst}%::match_id} is not {_sid}:
        stop
    if {bridge::player::%{_u}%::life_id} is not {_life}:
        stop
    if {_p}'s inventory does not contain arrow:
        set slot 8 of {_p}'s inventory to 1 arrow
        bridge_corePling({_p}, 1.8)
        bridge_sendActionBar({_p}, "&a+1 Flecha regenerada!")
        send "%{bridge::config::prefix}% &aFlecha reposta &8| &7O arco está disponível." to {_p}

on pickup:
    if {bridge::player::%player's uuid%::state} is "INGAME":
        set {_gInst} to {bridge::player::%player's uuid%::instance}
        if bridge_pauseActionsBlocked({_gInst}) is true:
            cancel event
            stop
        if type of event-item is not stained clay:
            cancel event

on drop:
    if {bridge::player::%player's uuid%::state} is "INGAME":
        set {_gInst} to {bridge::player::%player's uuid%::instance}
        if bridge_pauseActionsBlocked({_gInst}) is true:
            cancel event
            stop
        if type of event-item is not stained clay:
            cancel event

on inventory click:
    if {bridge::player::%player's uuid%::state} is "INGAME":
        set {_inst} to {bridge::player::%player's uuid%::instance}
        if bridge_pauseItemsBlocked({_inst}) is true:
            cancel event
            stop
        if index of event-slot is 36 or 37 or 38 or 39:
            cancel event
        if "%click type%" contains "SHIFT":
            if index of event-slot is 36 or 37 or 38 or 39:
                cancel event

on block place:
    set {_inst} to {bridge::player::%player's uuid%::instance}
    if {_inst} is not set:
        if player is not op:
            cancel event
        stop

    if bridge_pauseActionsBlocked({_inst}) is true:
        cancel event
        stop

    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        cancel event
        stop

    if event-block is not stained clay:
        cancel event
        stop

    set {_arena} to {bridge::instance::%{_inst}%::arena}
    set {_orig} to {bridge::arena::%{_arena}%::center}
    set {_center} to bridge_getLoc({_orig}, {_inst})

    if y-coordinate of event-block > {bridge::arena::%{_arena}%::y-max}:
        cancel event
        send "%{bridge::config::erro}% &cVocê atingiu a altura máxima de construção desta arena." to player
        stop

    set {_bx} to floor(x-coordinate of event-block)
    set {_bz} to floor(z-coordinate of event-block)
    set {_cx} to floor(x-coordinate of {_center})
    set {_cz} to floor(z-coordinate of {_center})

    if {bridge::arena::%{_arena}%::axis} is "X":
        set {_long} to abs({_bx} - {_cx})
        set {_lat} to abs({_bz} - {_cz})
    else:
        set {_long} to abs({_bz} - {_cz})
        set {_lat} to abs({_bx} - {_cx})

    if {_long} > {bridge::arena::%{_arena}%::limite-ponte}:
        cancel event
        send "%{bridge::config::erro}% &cEsse bloco ultrapassa a distância longitudinal permitida." to player
        stop

    if {_lat} > {bridge::arena::%{_arena}%::limite-lateral}:
        cancel event
        send "%{bridge::config::erro}% &cEsse bloco ultrapassa a distância lateral permitida." to player
        stop

    if {bridge::instance::%{_inst}%::placed_blocks::*} does not contain location of event-block:
        add location of event-block to {bridge::instance::%{_inst}%::placed_blocks::*}

on block break:
    set {_inst} to {bridge::player::%player's uuid%::instance}
    if {_inst} is not set:
        if player is not op:
            cancel event
        stop

    if bridge_pauseActionsBlocked({_inst}) is true:
        cancel event
        stop

    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        cancel event
        stop

    set {_arena} to {bridge::instance::%{_inst}%::arena}
    set {_orig} to {bridge::arena::%{_arena}%::center}
    set {_center} to bridge_getLoc({_orig}, {_inst})

    set {_bx} to floor(x-coordinate of event-block)
    set {_bz} to floor(z-coordinate of event-block)
    set {_cx} to floor(x-coordinate of {_center})
    set {_cz} to floor(z-coordinate of {_center})

    if {bridge::arena::%{_arena}%::axis} is "X":
        set {_long} to abs({_bx} - {_cx})
        set {_lat} to abs({_bz} - {_cz})
    else:
        set {_long} to abs({_bz} - {_cz})
        set {_lat} to abs({_bx} - {_cx})

    if {bridge::instance::%{_inst}%::placed_blocks::*} contains location of event-block:
        remove location of event-block from {bridge::instance::%{_inst}%::placed_blocks::*}
        stop

    if event-block is stained clay:
        if {_long} <= {bridge::arena::%{_arena}%::limite-ponte}:
            if {_lat} <= 1:
                set {_bData} to data value of event-block
                set {_t1_col} to {bridge::arena::%{_arena}%::team::1::color}
                set {_t2_col} to {bridge::arena::%{_arena}%::team::2::color}
                
                if {_bData} is 0:
                    stop
                if {_t1_col} is set:
                    if {_bData} is {_t1_col}:
                        stop
                if {_t2_col} is set:
                    if {_bData} is {_t2_col}:
                        stop

    cancel event

on damage with priority highest:
    if victim is not player:
        stop
    set {_v} to victim
    set {_u} to {_v}'s uuid
    set {_inst} to {bridge::player::%{_u}%::instance}
    if {_inst} is not set:
        cancel event
        stop
    if bridge_isPresent({_v}, {_inst}) is not true:
        cancel event
        stop
    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        cancel event
        stop
    if bridge_pauseActionsBlocked({_inst}) is true:
        cancel event
        stop
    if event.isCancelled() is true:
        stop
    set {_until} to {bridge::player::%{_u}%::respawn_protected_until}
    if {_until} is set:
        if (unix timestamp of now) < {_until}:
            cancel event
            bridge_spawnProtectionNotice(event, {_v})
            stop
    if damage cause is fall:
        cancel event
        stop
    set {_projectile} to false
    if event is an instance of BridgeDamageByEntityEvent:
        set {_raw} to event.getDamager()
        if {_raw}.getType().name() is "ARROW":
            set {_projectile} to true
            set {_a} to {_raw}.getShooter()
            if {_a} is not player:
                cancel event
                stop
            set {_id} to {_raw}.getUniqueId().toString()
            if {-bridge::arrows::%{_id}%::instance} is not {_inst}:
                cancel event
                stop
            if {-bridge::arrows::%{_id}%::match_id} is not {bridge::instance::%{_inst}%::match_id}:
                cancel event
                stop
            if {-bridge::arrows::%{_id}%::shooter} is not {_a}'s uuid:
                cancel event
                stop
        else:
            set {_a} to {_raw}
            if {_a} is not player:
                cancel event
                stop
        if bridge_combatAllowed({_a}, {_v}) is not true:
            # Bloqueia dano/tag/feedback; NÃO declara atravessamento de aliados.
            cancel event
            stop
        set {-bridge::player::%{_u}%::last_attacker_name} to name of {_a}
        set {-bridge::player::%{_u}%::last_attacker_uuid} to {_a}'s uuid
        set {-bridge::player::%{_u}%::last_attacker_time} to unix timestamp of now
        set {-bridge::player::%{_u}%::tag_match_id} to {bridge::instance::%{_inst}%::match_id}
        set {-bridge::player::%{_u}%::tag_life_id} to {bridge::player::%{_u}%::life_id}
    if damage cause is void:
        cancel event
        set {_killer} to bridge_validTagName({_v})
        if {_killer} is "":
            bridge_respawnPlayer({_v}, "VOID", "")
        else:
            bridge_respawnPlayer({_v}, "VOID_KILL", {_killer})
        stop
    # Ambos são HP Bukkit. getFinalDamage inclui os modificadores do evento.
    set {_final} to event.getFinalDamage()
    set {_health} to {_v}.getHealth()
    if {_final} < 0:
        set {_final} to 0
    if {_projectile} is true:
        set {_after} to {_health} - {_final}
        bridge_projectileFeedback({_a}, {_v}, {_after})
    if {_final} >= {_health}:
        cancel event
        set {_killer} to bridge_validTagName({_v})
        bridge_respawnPlayer({_v}, "KILL", {_killer})


# Um ataque autorizado pertence à mesma sessão ativa e a times adversários.
function bridge_combatAllowed(a: player, v: player) :: boolean:
    if {_a} is {_v}:
        return false
    set {_inst} to {bridge::player::%{_v}'s uuid%::instance}
    if {_inst} is not set:
        return false
    if bridge_isPresent({_a}, {_inst}) is not true:
        return false
    if bridge_isPresent({_v}, {_inst}) is not true:
        return false
    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        return false
    if bridge_pauseActionsBlocked({_inst}) is true:
        return false
    if world of {_a} is not world of {_v}:
        return false
    set {_at} to {bridge::player::%{_a}'s uuid%::team}
    set {_vt} to {bridge::player::%{_v}'s uuid%::team}
    if {_at} is not set:
        return false
    if {_vt} is not set:
        return false
    if {_at} is {_vt}:
        return false
    return true

function bridge_validTagName(v: player) :: text:
    set {_u} to {_v}'s uuid
    set {_name} to {-bridge::player::%{_u}%::last_attacker_name}
    set {_time} to {-bridge::player::%{_u}%::last_attacker_time}
    if {_name} is not set:
        return ""
    if {_time} is not set:
        return ""
    if (unix timestamp of now) - {_time} > 5:
        return ""
    if {-bridge::player::%{_u}%::tag_match_id} is not {bridge::player::%{_u}%::match_id}:
        return ""
    if {-bridge::player::%{_u}%::tag_life_id} is not {bridge::player::%{_u}%::life_id}:
        return ""
    set {_a} to {_name} parsed as player
    if {_a} is not set:
        return ""
    if {_a}'s uuid is not {-bridge::player::%{_u}%::last_attacker_uuid}:
        return ""
    if bridge_combatAllowed({_a}, {_v}) is not true:
        return ""
    return {_name}

# Remove referências de projéteis encerrados; não remove entidades do mundo.
every 10 seconds:
    loop {-bridge::arrow_entities::*}:
        set {_entity} to loop-value
        if {_entity}.isValid() is false:
            set {_key} to loop-index
            delete {-bridge::arrows::%{_key}%::*}
            delete {-bridge::arrow_entities::%{_key}%}


# Feedback somente para atacante adversário válido; dano continua cancelado.
function bridge_spawnProtectionNotice(e: object, v: player):
    if {_e} is not an instance of BridgeDamageByEntityEvent:
        stop
    set {_raw} to {_e}.getDamager()
    if {_raw}.getType().name() is "ARROW":
        set {_a} to {_raw}.getShooter()
        if {_a} is not a player:
            stop
        set {_inst} to {bridge::player::%{_v}'s uuid%::instance}
        set {_id} to {_raw}.getUniqueId().toString()
        if {-bridge::arrows::%{_id}%::instance} is not {_inst}:
            stop
        if {-bridge::arrows::%{_id}%::match_id} is not {bridge::instance::%{_inst}%::match_id}:
            stop
        if {-bridge::arrows::%{_id}%::shooter} is not {_a}'s uuid:
            stop
    else:
        set {_a} to {_raw}
        if {_a} is not a player:
            stop
    if bridge_combatAllowed({_a}, {_v}) is not true:
        stop
    send "%{bridge::config::prefix}% &e%bridge_getFormattedPlayerName({_v})% &eestá protegido após o respawn." to {_a}
