# THE BRIDGE - ESTATÍSTICAS E FEEDBACK DE COMBATE (ETAPA 2.1)
# ================================================================

import:
    org.bukkit.Sound

# ---------------------------------------------------------
# FUNÇÕES DE REGISTRO DE STATS
# ---------------------------------------------------------
function bridge_addStat(p: offline player, stat: text, amount: integer = 1):
    set {_u} to {_p}'s uuid
    if {bridge::stats::%{_u}%::%{_stat}%} is not set:
        set {bridge::stats::%{_u}%::%{_stat}%} to 0
    add {_amount} to {bridge::stats::%{_u}%::%{_stat}%}

function bridge_getStat(p: offline player, stat: text) :: integer:
    set {_u} to {_p}'s uuid
    if {bridge::stats::%{_u}%::%{_stat}%} is not set:
        return 0
    return {bridge::stats::%{_u}%::%{_stat}%}

# ---------------------------------------------------------
# COMANDO /STATS
# ---------------------------------------------------------
command /stats [<offline player>]:
    aliases: /status, /perfil
    trigger:
        set {_target} to arg-1
        if {_target} is not set:
            if executor is a player:
                set {_target} to executor
            else:
                send "%{bridge::config::prefix}% &eNo console, use &f/stats <jogador>&e." to executor
                stop

        set {_u} to {_target}'s uuid
        set {_v} to bridge_getStat({_target}, "wins")
        set {_d} to bridge_getStat({_target}, "losses")
        set {_k} to bridge_getStat({_target}, "kills")
        set {_m} to bridge_getStat({_target}, "deaths")
        set {_g} to bridge_getStat({_target}, "goals")
        set {_p} to bridge_getStat({_target}, "games")

        # Cálculo de KDR
        set {_kdr} to 0.0
        if {_m} > 0:
            set {_kdr} to {_k} / {_m}
        else if {_k} > 0:
            set {_kdr} to {_k}

        send "" to executor
        send "&8&m------------------------------" to executor
        send " &9&lTHE BRIDGE &8| &f%name of {_target}%" to executor
        send " &7Partidas &8» &f%{_p}%" to executor
        send " &7Vitórias &8» &a%{_v}% &8| &7Derrotas &8» &c%{_d}%" to executor
        send " &7Gols &8» &e%{_g}%" to executor
        send " &7Abates &8» &a%{_k}% &8| &7Mortes &8» &c%{_m}%" to executor
        send " &7KDR &8» &f%{_kdr}%" to executor
        send "&8&m------------------------------" to executor
        send "" to executor

# ---------------------------------------------------------
# FEEDBACK DE ARCO E FLECHA (ACTIONBAR + CHAT + SOM)
# ---------------------------------------------------------
function bridge_projectileFeedback(a: player, v: player, healthHP: number):
    if bridge_combatAllowed({_a}, {_v}) is not true:
        stop
    set {_hp} to max(0, {_healthHP}) / 2
    set {_formatted} to floor({_hp} * 10) / 10
    set {_name} to bridge_getFormattedPlayerName({_v})
    bridge_sendActionBar({_a}, "%{_name}% &8| &7Vida estimada: &c%{_formatted}% ❤")
    send "%{bridge::config::prefix}% %{_name}% &8| &7Vida estimada: &c%{_formatted}% ❤" to {_a}
    {_a}.playSound({_a}.getLocation(), Sound.ORB_PICKUP, 1.0, 0.5)

