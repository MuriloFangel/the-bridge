# THE BRIDGE - CORE / FILA E COORDENAÇÃO DO CICLO DA PARTIDA
# Fechamento 1 parcial: correções de combate, vida e resultado; ver manifesto.
# Requer o conjunto de módulos Bridge existente; não é um script independente.
# Revisão estática não certifica carregamento nem gameplay.
# ================================================================

# O agendador de 1s permanece aqui; seu controlador está em Suspension.
# Encerramento de tempo, início/fim da sessão e helpers compartilhados ficam aqui.

import:
    org.bukkit.Bukkit
    org.bukkit.Material
    org.bukkit.Color
    org.bukkit.Sound
    org.bukkit.entity.Arrow
    org.bukkit.entity.Item
    org.bukkit.inventory.ItemStack
    org.bukkit.enchantments.Enchantment
    org.bukkit.util.Vector
    java.util.UUID as BridgeQueueUUID
    com.google.gson.JsonObject as BridgeQueueJson

function bridge_chatInstance(inst: text, msg: text):
    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            send "%{bridge::config::prefix}% %{_msg}%" to loop-value
    loop {bridge::instance::%{_inst}%::team::2::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            send "%{bridge::config::prefix}% %{_msg}%" to loop-value

function bridge_getTeamColorCode(colorData: integer) :: text:
    if {_colorData} is 11:
        return "&9" # Azul
    if {_colorData} is 14:
        return "&c" # Vermelho
    if {_colorData} is 5:
        return "&a" # Verde
    if {_colorData} is 4:
        return "&e" # Amarelo
    return "&7"

function bridge_getTeamName(colorData: integer) :: text:
    if {_colorData} is 11:
        return "&9Time Azul"
    if {_colorData} is 14:
        return "&cTime Vermelho"
    if {_colorData} is 5:
        return "&aTime Verde"
    if {_colorData} is 4:
        return "&eTime Amarelo"
    return "&7Time"

function bridge_getFormattedPlayerName(p: player) :: text:
    set {_u} to {_p}'s uuid
    set {_inst} to {bridge::player::%{_u}%::instance}
    if {_inst} is set:
        set {_team} to {bridge::player::%{_u}%::team}
        set {_arena} to {bridge::instance::%{_inst}%::arena}
        set {_cData} to {bridge::arena::%{_arena}%::team::%{_team}%::color}
        set {_code} to bridge_getTeamColorCode({_cData})
        return "%{_code}%%name of {_p}%"
    return "&f%name of {_p}%"

# Os consumidores publicam feedback; somente bridge_actionbarRender envia a barra.
function bridge_sendActionBar(p: player, msg: text):
    if {_p} is not online:
        stop
    set {_u} to {_p}'s uuid
    set {_inst} to {bridge::player::%{_u}%::instance}
    if {_inst} is not set:
        stop
    if bridge_isPresent({_p}, {_inst}) is not true:
        stop
    set {-bridge::actionbar::%{_u}%::feedback} to {_msg}
    set {-bridge::actionbar::%{_u}%::until} to (unix timestamp of now) + 2
    set {-bridge::actionbar::%{_u}%::sid} to {bridge::instance::%{_inst}%::match_id}
    set {-bridge::actionbar::%{_u}%::life} to {bridge::player::%{_u}%::life_id}

function bridge_actionbarRender(p: player):
    set {_u} to {_p}'s uuid
    set {_message} to ""
    set {_inst} to {bridge::player::%{_u}%::instance}
    set {_present} to false
    if {_inst} is set:
        if bridge_isPresent({_p}, {_inst}) is true:
            set {_present} to true
    if {_present} is true:
        set {_sid} to {bridge::instance::%{_inst}%::match_id}
        set {_life} to {bridge::player::%{_u}%::life_id}
        if {bridge::instance::%{_inst}%::resume_active} is true:
            set {_message} to "&eRETOMANDO &8| &7Aguarde o VALENDO"
        else if {bridge::instance::%{_inst}%::frozen} is true:
            set {_left} to {bridge::instance::%{_inst}%::freeze_timer}
            set {_message} to "&cAGUARDANDO PRESENCA &8| &f%{_left}%s &8| &7Partida bloqueada"
        else if {bridge::instance::%{_inst}%::in_pause} is true:
            set {_left} to {bridge::instance::%{_inst}%::pause_timer}
            set {_message} to "&ePAUSA &8| &f%{_left}%s &8| &7Time solicitante: /despausar"
        else if {bridge::instance::%{_inst}%::voting::active} is true:
            set {_kind} to {bridge::instance::%{_inst}%::voting::type}
            set {_left} to max(0, ceil({bridge::instance::%{_inst}%::voting::deadline} - (unix timestamp of now)))
            set {_message} to "&eVOTACAO: %{_kind}% &8| &f%{_left}%s &8| &7/bridgevote sim ou nao"
        if {-bridge::actionbar::%{_u}%::sid} is {_sid}:
            if {-bridge::actionbar::%{_u}%::life} is {_life}:
                if {-bridge::actionbar::%{_u}%::until} > (unix timestamp of now):
                    set {_feedback} to {-bridge::actionbar::%{_u}%::feedback}
                    if {_feedback} is set:
                        if {_message} is "":
                            set {_message} to {_feedback}
                        else:
                            set {_message} to "%{_message}% &8| %{_feedback}%"
        if {bridge::player::%{_u}%::arrow_reload::sid} is {_sid}:
            if {bridge::player::%{_u}%::arrow_reload::life} is {_life}:
                if {bridge::player::%{_u}%::arrow_reload::instance} is {_inst}:
                    set {_leftTicks} to {bridge::player::%{_u}%::arrow_reload::remaining}
                    if {_leftTicks} is set:
                        set {_green} to floor((70 - {_leftTicks}) / 10)
                        set {_green} to max(0, min(7, {_green}))
                        set {_dots} to ""
                        loop 7 times:
                            if loop-value <= {_green}:
                                set {_dots} to "%{_dots}%&a●"
                            else:
                                set {_dots} to "%{_dots}%&7●"
                        if {_message} is "":
                            set {_message} to "&7Flecha &8[%{_dots}%&8]"
                        else:
                            set {_message} to "%{_message}% &8| &7Flecha &8[%{_dots}%&8]"
    else:
        delete {-bridge::actionbar::%{_u}%::feedback}
        delete {-bridge::actionbar::%{_u}%::until}
        delete {-bridge::actionbar::%{_u}%::sid}
        delete {-bridge::actionbar::%{_u}%::life}
    set {_last} to {-bridge::actionbar::%{_u}%::last}
    set {_refresh} to false
    if {_last} is not {_message}:
        set {_refresh} to true
    if {_message} is not "":
        if {-bridge::actionbar::%{_u}%::refresh_at} is not set:
            set {_refresh} to true
        else if {-bridge::actionbar::%{_u}%::refresh_at} <= (unix timestamp of now):
            set {_refresh} to true
    if {_refresh} is true:
        if {_message} is not "":
            send action bar colored {_message} to {_p}
        else if {_last} is set:
            if {_last} is not "":
                send action bar "" to {_p}
        set {-bridge::actionbar::%{_u}%::last} to {_message}
        set {-bridge::actionbar::%{_u}%::refresh_at} to (unix timestamp of now) + 1

every 2 ticks:
    loop all players:
        bridge_actionbarRender(loop-player)

on quit:
    delete {-bridge::actionbar::%player's uuid%::*}

function bridge_coreTitle(p: player, titleText: text, subText: text, ticks: integer = 20):
    if {_p} is online:
        set {_t} to colored {_titleText}
        set {_s} to colored {_subText}
        {_p}.sendTitle({_t}, {_s})

function bridge_corePling(p: player, pitchValue: number):
    if {_p} is online:
        set {_loc} to {_p}.getLocation()
        {_p}.playSound({_loc}, Sound.NOTE_PLING, 1.0, {_pitchValue})

function bridge_fixVisibility(inst: text):
    wait 2 ticks
    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        set {_p1} to loop-value-1
        loop {bridge::instance::%{_inst}%::team::2::players::*}:
            set {_p2} to loop-value-2
            if bridge_isPresent({_p1}, {_inst}) is true:
                if bridge_isPresent({_p2}, {_inst}) is true:
                    {_p1}.hidePlayer({_p2})
                    {_p1}.showPlayer({_p2})
                    {_p2}.hidePlayer({_p1})
                    {_p2}.showPlayer({_p1})

every 1 second:
    loop {bridge::core::active_instances::*}:
        bridge_tickPauseControl(loop-value)

function bridge_broadcastInstanceActionBar(inst: text, msg: text):
    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            bridge_sendActionBar(loop-value, {_msg})
    loop {bridge::instance::%{_inst}%::team::2::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            bridge_sendActionBar(loop-value, {_msg})

function bridge_handleTimeEnd(inst: text):
    if {bridge::instance::%{_inst}%::state} is not "INGAME":
        stop

    if {bridge::instance::%{_inst}%::golden_goal_voted} is true:
        stop
    if {bridge::instance::%{_inst}%::voting::active} is true:
        if {bridge::instance::%{_inst}%::voting::type} is "PAUSA":
            delete {bridge::instance::%{_inst}%::voting::active}
            bridge_chatInstance({_inst}, "&eTempo regulamentar encerrado. Pedido de pausa cancelado sem cobrança.")

    set {_s1} to {bridge::instance::%{_inst}%::team::1::score}
    set {_s2} to {bridge::instance::%{_inst}%::team::2::score}
    if {_s1} is not set:
        set {_s1} to 0
    if {_s2} is not set:
        set {_s2} to 0

    if {_s1} > {_s2}:
        bridge_endMatch({_inst}, 1)
    else if {_s2} > {_s1}:
        bridge_endMatch({_inst}, 2)
    else:
        set {bridge::instance::%{_inst}%::golden_goal_voted} to true
        bridge_startVote({_inst}, "GOL DE OURO", 30)

command /jogar [<text>]:
    aliases: /play, /join
    executable by: players
    trigger:
        set {_u} to player's uuid

        if {bridge::config::lobby} is not set:
            send "%{bridge::config::erro}% &cO lobby do Bridge ainda não foi definido. Avise a administração." to player
            stop
        if {bridge::player::%{_u}%::state} is set:
            send "%{bridge::config::erro}% &cVocê já está em uma fila ou partida." to player
            stop
        set {_arena} to arg-1
        if {_arena} is not set:
            set {_arena} to first element of {bridge::arenas::*}
        if {_arena} is not set:
            send "%{bridge::config::erro}% &cNenhuma arena cadastrada." to player
            stop
        if {bridge::arenas::*} does not contain {_arena}:
            send "%{bridge::config::erro}% &cArena não encontrada. Consulte as opções em /arenas." to player
            stop
        if {bridge::return::%{_u}%::instance} is set:
            send "%{bridge::config::prefix}% &eVocê ainda pode usar /l e /retornar enquanto espera. Se outra partida começar, o retorno à anterior será encerrado." to player
        bridge_joinQueue(player, {_arena})

function bridge_joinQueue(p: player, arena: text):
    delete {_opponent}
    loop {bridge::queue::%{_arena}%::*}:
        set {_candidate} to loop-value
        if {_candidate} is online:
            if {_candidate} is not {_p}:
                if bridge_queueWaiting({_candidate}, {_arena}, "1v1") is true:
                    set {_opponent} to {_candidate}
                    remove {_candidate} from {bridge::queue::%{_arena}%::*}
                    exit loop
        remove {_candidate} from {bridge::queue::%{_arena}%::*}
    if {_opponent} is set:
        # A segunda entrada e pareada imediatamente, sem criar espera artificial.
        send "%{bridge::config::prefix}% &f%name of {_p}% &aentrou na fila &8— &f2/2 &7(%{_arena}% | 1v1)." to {_opponent}
        send "%{bridge::config::prefix}% &f%name of {_p}% &aentrou na fila &8— &f2/2 &7(%{_arena}% | 1v1)." to {_p}
        bridge_startMatch({_opponent}, {_p}, {_arena})
        stop
    add {_p} to {bridge::queue::%{_arena}%::*}
    set {bridge::player::%{_p}'s uuid%::state} to "QUEUE"
    set {bridge::player::%{_p}'s uuid%::queue_arena} to {_arena}
    bridge_queueJoined({_p}, {_arena}, "1v1")

# Avisos de fila: somente entradas online que ainda pertencem ao formato/arena.
function bridge_queueWaiting(p: player, arena: text, mode: text) :: boolean:
    if {_p} is not online:
        return false
    set {_u} to {_p}'s uuid
    if {bridge::player::%{_u}%::state} is not "QUEUE":
        return false
    if {bridge::player::%{_u}%::queue_arena} is not {_arena}:
        return false
    if {_mode} is "2v2":
        return bridge_duosWaiting({_u}, {_arena})
    if {_mode} is not "1v1":
        return false
    # O Core legado nao gravava queue_mode para 1v1.
    if {bridge::player::%{_u}%::queue_mode} is set:
        if {bridge::player::%{_u}%::queue_mode} is not "1v1":
            return false
    if {bridge::queue::%{_arena}%::*} contains {_p}:
        return true
    return false

function bridge_queueCount(arena: text, mode: text) :: integer:
    set {_count} to 0
    # A lista de jogadores conectados nao duplica UUIDs de registros antigos.
    loop all players:
        if bridge_queueWaiting(loop-player, {_arena}, {_mode}) is true:
            add 1 to {_count}
    return {_count}

function bridge_queueNotice(arena: text, mode: text, message: text):
    loop all players:
        if bridge_queueWaiting(loop-player, {_arena}, {_mode}) is true:
            send "%{bridge::config::prefix}% %{_message}%" to loop-player

function bridge_queueJoined(p: player, arena: text, mode: text):
    if bridge_queueWaiting({_p}, {_arena}, {_mode}) is not true:
        stop
    set {_count} to bridge_queueCount({_arena}, {_mode})
    set {_capacity} to 2
    if {_mode} is "2v2":
        set {_capacity} to 4
    bridge_queueNotice({_arena}, {_mode}, "&f%name of {_p}% &aentrou na fila &8— &f%{_count}%/%{_capacity}% &7(%{_arena}% | %{_mode}%).")
    send "&7Aguardando jogadores. Use &f/l &7para sair." to {_p}
    bridge_queueAdOffer({_p}, {_arena}, {_mode})

# Divulgacao de fila; nao implementa canais de chat nem entrada coletiva.
function bridge_queueAdButton(p: player, message: text, commandText: text):
    if {_p} is not online:
        stop
    # Gson escapa arena/texto; o clique transporta apenas acao e UUID.
    set {_json} to new BridgeQueueJson()
    set {_shown} to colored {_message}
    {_json}.addProperty("text", {_shown})
    set {_click} to new BridgeQueueJson()
    {_click}.addProperty("action", "run_command")
    {_click}.addProperty("value", {_commandText})
    {_json}.add("clickEvent", {_click})
    set {_payload} to {_json}.toString()
    execute console command "tellraw %name of {_p}% %{_payload}%"

function bridge_queueAdOffer(p: player, arena: text, mode: text):
    if bridge_queueWaiting({_p}, {_arena}, {_mode}) is not true:
        stop
    set {_u} to {_p}'s uuid
    if {bridge::player::%{_u}%::queue_ad_entry} is not set:
        set {bridge::player::%{_u}%::queue_ad_entry} to BridgeQueueUUID.randomUUID().toString()
    bridge_queueAdButton({_p}, "&e[DIVULGAR FILA NO CHAT GERAL]", "/bridgefila divulgar")
    send "&7Divulgacao: intervalo de 30s compartilhado por esta fila." to {_p}

function bridge_queueAdPublish(p: player):
    set {_u} to {_p}'s uuid
    set {_arena} to {bridge::player::%{_u}%::queue_arena}
    set {_mode} to "1v1"
    if {bridge::player::%{_u}%::queue_mode} is "2v2":
        set {_mode} to "2v2"
    if {_arena} is not set:
        send "%{bridge::config::erro}% &cEntre em uma fila antes de divulgar." to {_p}
        stop
    if bridge_queueWaiting({_p}, {_arena}, {_mode}) is not true:
        send "%{bridge::config::erro}% &cVoce nao esta mais nessa fila de espera." to {_p}
        stop
    if {bridge::arenas::*} does not contain {_arena}:
        send "%{bridge::config::erro}% &cArena indisponivel." to {_p}
        stop
    if {-bridge::setup::%{_arena}%::active} is true:
        send "%{bridge::config::erro}% &cAguarde o cadastro da arena terminar." to {_p}
        stop
    set {_count} to bridge_queueCount({_arena}, {_mode})
    set {_capacity} to 2
    if {_mode} is "2v2":
        set {_capacity} to 4
    if {_count} >= {_capacity}:
        send "%{bridge::config::prefix}% &eA fila ja esta completa. Aguarde o inicio." to {_p}
        stop
    set {_now} to unix timestamp of now
    set {_deadline} to {bridge::queue_ad::%{_arena}%::%{_mode}%::next_at}
    if {_deadline} is set:
        if {_deadline} > {_now}:
            set {_left} to ceil({_deadline} - {_now})
            send "%{bridge::config::prefix}% &eEsta fila podera ser divulgada novamente em %{_left}%s." to {_p}
            stop
    if {bridge::player::%{_u}%::queue_ad_entry} is not set:
        set {bridge::player::%{_u}%::queue_ad_entry} to BridgeQueueUUID.randomUUID().toString()
    set {_token} to BridgeQueueUUID.randomUUID().toString()
    set {bridge::queue_ad::%{_arena}%::%{_mode}%::token} to {_token}
    set {bridge::queue_ad::%{_arena}%::%{_mode}%::host} to "%{_u}%"
    set {bridge::queue_ad::%{_arena}%::%{_mode}%::host_entry} to {bridge::player::%{_u}%::queue_ad_entry}
    # Nao limpar este prazo na saida do anunciante: cooldown e da fila.
    set {bridge::queue_ad::%{_arena}%::%{_mode}%::next_at} to {_now} + 30
    set {_message} to "&e[FILA] &a%name of {_p}% &7esta esperando em &f%{_arena}% &8| &e%{_mode}% &8| &f%{_count}%/%{_capacity}% &a[ENTRAR]"
    loop all players:
        bridge_queueAdButton(loop-player, {_message}, "/bridgefila entrar %{_token}%")

function bridge_queueAdJoin(p: player, adToken: text):
    set {_u} to {_p}'s uuid
    if {bridge::player::%{_u}%::state} is set:
        send "%{bridge::config::erro}% &cVoce ja esta em fila ou partida. Use /l antes de trocar." to {_p}
        stop
    if {bridge::config::lobby} is not set:
        send "%{bridge::config::erro}% &cLobby nao configurado." to {_p}
        stop
    # Resolve apenas tokens atuais de arenas cadastradas; nenhum ID vira comando.
    loop {bridge::arenas::*}:
        set {_candidateArena} to loop-value
        if {bridge::queue_ad::%{_candidateArena}%::1v1::token} is {_adToken}:
            set {_arena} to {_candidateArena}
            set {_mode} to "1v1"
            exit loop
        if {bridge::queue_ad::%{_candidateArena}%::2v2::token} is {_adToken}:
            set {_arena} to {_candidateArena}
            set {_mode} to "2v2"
            exit loop
    if {_arena} is not set:
        send "%{bridge::config::erro}% &cDivulgacao antiga ou indisponivel." to {_p}
        stop
    if {-bridge::setup::%{_arena}%::active} is true:
        send "%{bridge::config::erro}% &cAguarde o cadastro da arena terminar." to {_p}
        stop
    set {_hostKey} to {bridge::queue_ad::%{_arena}%::%{_mode}%::host}
    set {_hostId} to try BridgeQueueUUID.fromString({_hostKey})
    if {_hostId} is not set:
        send "%{bridge::config::erro}% &cDivulgacao invalida." to {_p}
        stop
    set {_host} to Bukkit.getPlayer({_hostId})
    if {_host} is not set:
        send "%{bridge::config::erro}% &cO anunciante nao esta mais esperando nessa fila." to {_p}
        stop
    if bridge_queueWaiting({_host}, {_arena}, {_mode}) is not true:
        send "%{bridge::config::erro}% &cEssa divulgacao nao corresponde mais a uma espera valida." to {_p}
        stop
    set {_entry} to {bridge::player::%{_hostKey}%::queue_ad_entry}
    if {_entry} is not set:
        send "%{bridge::config::erro}% &cDivulgacao encerrada." to {_p}
        stop
    if {bridge::queue_ad::%{_arena}%::%{_mode}%::host_entry} is not {_entry}:
        send "%{bridge::config::erro}% &cO anunciante saiu e entrou novamente. Use uma divulgacao atual." to {_p}
        stop
    set {_count} to bridge_queueCount({_arena}, {_mode})
    set {_capacity} to 2
    if {_mode} is "2v2":
        set {_capacity} to 4
    if {_count} <= 0:
        send "%{bridge::config::erro}% &cEssa fila de espera foi encerrada." to {_p}
        stop
    if {_count} >= {_capacity}:
        send "%{bridge::config::erro}% &cA fila ja esta completa. Use uma divulgacao atual." to {_p}
        stop
    # Sem waits entre validacoes e delegacao; comandos normais revalidam entrada.
    set {_command} to "jogar %{_arena}%"
    if {_mode} is "2v2":
        set {_command} to "jogar2v2 %{_arena}%"
    set {_accepted} to {_p}.performCommand({_command})

command /bridgefila [<text>] [<text>]:
    executable by: players
    trigger:
        if arg-1 is "divulgar":
            bridge_queueAdPublish(player)
            stop
        if arg-1 is "entrar":
            if arg-2 is not set:
                send "%{bridge::config::erro}% &cUse o botao de uma divulgacao atual." to player
                stop
            bridge_queueAdJoin(player, arg-2)
            stop
        send "%{bridge::config::prefix}% &e/bridgefila divulgar &7- divulga sua fila; intervalo compartilhado de 30s." to player

on load:
    set {bridge::tab::custom::bridgefila::1::*} to "divulgar"
    # Oferece o botao tambem a quem ja aguardava antes deste carregamento.
    wait 2 ticks
    loop all players:
        set {_u} to loop-player's uuid
        if {bridge::player::%{_u}%::state} is "QUEUE":
            set {_arena} to {bridge::player::%{_u}%::queue_arena}
            if {_arena} is set:
                set {_mode} to "1v1"
                if {bridge::player::%{_u}%::queue_mode} is "2v2":
                    set {_mode} to "2v2"
                bridge_queueAdOffer(loop-player, {_arena}, {_mode})

on unload:
    delete {bridge::tab::custom::bridgefila::*}

function bridge_queueDepart(p: player, reason: text):
    set {_u} to {_p}'s uuid
    if {bridge::player::%{_u}%::state} is not "QUEUE":
        stop
    set {_arena} to {bridge::player::%{_u}%::queue_arena}
    set {_mode} to "1v1"
    if {bridge::player::%{_u}%::queue_mode} is "2v2":
        set {_mode} to "2v2"
    set {_valid} to false
    # Nao exigir isOnline no evento quit: validar o registro que esta saindo.
    if {_arena} is set:
        if {_mode} is "2v2":
            set {_ticket} to {bridge::duos_queue::%{_arena}%::tickets::%{_u}%}
            if {_ticket} is set:
                if {bridge::player::%{_u}%::queue_ticket} is {_ticket}:
                    if {bridge::duos_queue::%{_arena}%::members::*} contains {_u}:
                        set {_valid} to true
            bridge_duosForget({_arena}, {_u})
        else:
            if {bridge::player::%{_u}%::queue_mode} is not set:
                if {bridge::queue::%{_arena}%::*} contains {_p}:
                    set {_valid} to true
            else if {bridge::player::%{_u}%::queue_mode} is "1v1":
                if {bridge::queue::%{_arena}%::*} contains {_p}:
                    set {_valid} to true
        remove {_p} from {bridge::queue::%{_arena}%::*}
    # Mantem a limpeza que /l e quit ja faziam, sem tocar no vinculo de retorno.
    delete {bridge::player::%{_u}%::*}
    if {_valid} is not true:
        stop
    set {_count} to bridge_queueCount({_arena}, {_mode})
    set {_capacity} to 2
    if {_mode} is "2v2":
        set {_capacity} to 4
    bridge_queueNotice({_arena}, {_mode}, "&f%name of {_p}% &esaiu da fila (%{_reason}%) &8— &f%{_count}%/%{_capacity}% &7(%{_arena}% | %{_mode}%).")

function bridge_findFreeInstance(arena: text) :: text:
    loop {bridge::arena::%{_arena}%::instances::*}:
        set {_inst} to loop-value
        if {bridge::instances::free::*} contains {_inst}:
            set {_state} to {bridge::instance::%{_inst}%::state}
            if {_state} is not set:
                return {_inst}
            if {_state} is "IDLE":
                return {_inst}
    return ""

function bridge_startMatch(p1: player, p2: player, arena: text):
    set {_inst} to bridge_findFreeInstance({_arena})
    if {_inst} is "":
        bridge_expandInstances({_arena}, 1)
        set {_inst} to bridge_findFreeInstance({_arena})
    if {_inst} is "":
        remove {_p1} from {bridge::queue::%{_arena}%::*}
        remove {_p2} from {bridge::queue::%{_arena}%::*}
        delete {bridge::player::%{_p1}'s uuid%::*}
        delete {bridge::player::%{_p2}'s uuid%::*}
        send "%{bridge::config::erro}% &cFalha ao alocar arena. Digite /jogar novamente." to {_p1}
        send "%{bridge::config::erro}% &cFalha ao alocar arena. Digite /jogar novamente." to {_p2}
        stop

    bridge_registerDefinitiveAbandon({_p1})
    bridge_registerDefinitiveAbandon({_p2})
    bridge_detachPrevious({_p1})
    bridge_detachPrevious({_p2})
    remove {_inst} from {bridge::instances::free::*}
    if {bridge::core::active_instances::*} does not contain {_inst}:
        add {_inst} to {bridge::core::active_instances::*}

    set {bridge::instance::%{_inst}%::state} to "STARTING"
    
    set {_maxTime} to {bridge::arena::%{_arena}%::tempo}
    if {_maxTime} is not set:
        set {_maxTime} to 900
    set {bridge::instance::%{_inst}%::time_remaining} to {_maxTime}
    set {bridge::instance::%{_inst}%::time_initial} to {_maxTime}
    delete {bridge::instance::%{_inst}%::time_notices::*}
    delete {bridge::instance::%{_inst}%::frozen}
    delete {bridge::instance::%{_inst}%::freeze_reason}
    delete {bridge::instance::%{_inst}%::freeze_player_name}
    delete {bridge::instance::%{_inst}%::freeze_team}
    delete {bridge::instance::%{_inst}%::freeze_timer}
    delete {bridge::instance::%{_inst}%::in_pause}
    delete {bridge::instance::%{_inst}%::pause_resume_votes::*}
    delete {bridge::instance::%{_inst}%::resume_kind}
    delete {bridge::instance::%{_inst}%::golden_goal}
    delete {bridge::instance::%{_inst}%::golden_goal_voted}
    delete {bridge::instance::%{_inst}%::pauses::1}
    delete {bridge::instance::%{_inst}%::pauses::2}
    delete {bridge::instance::%{_inst}%::voting::active}
    
    if {bridge::core::session_counter} is not set:
        set {bridge::core::session_counter} to 0
    add 1 to {bridge::core::session_counter}
    set {bridge::instance::%{_inst}%::match_id} to {bridge::core::session_counter}
    
    delete {bridge::instance::%{_inst}%::closing_id}
    delete {bridge::instance::%{_inst}%::team::1::players::*}
    delete {bridge::instance::%{_inst}%::team::2::players::*}
    delete {bridge::instance::%{_inst}%::placed_blocks::*}

    add {_p1} to {bridge::instance::%{_inst}%::team::1::players::*}
    add {_p2} to {bridge::instance::%{_inst}%::team::2::players::*}

    set {bridge::instance::%{_inst}%::team::1::score} to 0
    set {bridge::instance::%{_inst}%::team::2::score} to 0

    delete {bridge::player::%{_p1}'s uuid%::queue_arena}
    delete {bridge::player::%{_p2}'s uuid%::queue_arena}

    set {bridge::player::%{_p1}'s uuid%::instance} to {_inst}
    set {bridge::player::%{_p1}'s uuid%::team} to 1
    set {bridge::player::%{_p1}'s uuid%::state} to "INGAME"
    set {bridge::player::%{_p1}'s uuid%::match_kills} to 0
    set {bridge::player::%{_p1}'s uuid%::match_goals} to 0

    set {bridge::player::%{_p2}'s uuid%::instance} to {_inst}
    set {bridge::player::%{_p2}'s uuid%::team} to 2
    set {bridge::player::%{_p2}'s uuid%::state} to "INGAME"
    set {bridge::player::%{_p2}'s uuid%::match_kills} to 0
    set {bridge::player::%{_p2}'s uuid%::match_goals} to 0

    delete {bridge::instance::%{_inst}%::members::*}
    delete {bridge::instance::%{_inst}%::resume_active}
    set {bridge::instance::%{_inst}%::team::1::initial_size} to size of {bridge::instance::%{_inst}%::team::1::players::*}
    set {bridge::instance::%{_inst}%::team::2::initial_size} to size of {bridge::instance::%{_inst}%::team::2::players::*}
    loop 2 times:
        set {_t} to loop-value
        loop {bridge::instance::%{_inst}%::team::%{_t}%::players::*}:
            set {_member} to loop-value-2
            set {_mu} to {_member}'s uuid
            set {bridge::player::%{_mu}%::match_id} to {bridge::instance::%{_inst}%::match_id}
            set {bridge::instance::%{_inst}%::members::%{_mu}%::match_id} to {bridge::instance::%{_inst}%::match_id}
            set {bridge::instance::%{_inst}%::members::%{_mu}%::team} to {_t}
            set {bridge::instance::%{_inst}%::members::%{_mu}%::present} to true
            set {bridge::instance::%{_inst}%::members::%{_mu}%::match_kills} to 0
            set {bridge::instance::%{_inst}%::members::%{_mu}%::match_goals} to 0

    set {_n1} to bridge_getFormattedPlayerName({_p1})
    set {_n2} to bridge_getFormattedPlayerName({_p2})

    send "%{bridge::config::prefix}% &aPartida encontrada! Você jogará contra %{_n2}%&a." to {_p1}
    send "%{bridge::config::prefix}% &aPartida encontrada! Você jogará contra %{_n1}%&a." to {_p2}

    bridge_startRound({_inst})

function bridge_endMatch(inst: text, winnerTeam: integer):
    set {_state} to {bridge::instance::%{_inst}%::state}
    set {_canEnd} to false
    if {_state} is "STARTING":
        set {_canEnd} to true
    if {_state} is "CAGE":
        set {_canEnd} to true
    if {_state} is "INGAME":
        set {_canEnd} to true
    if {_state} is "GOAL":
        set {_canEnd} to true

    if {_canEnd} is false:
        stop

    set {_closingId} to {bridge::instance::%{_inst}%::match_id}
    if {_closingId} is not set:
        stop

    loop 2 times:
        set {_t} to loop-value
        loop {bridge::instance::%{_inst}%::team::%{_t}%::players::*}:
            set {_member} to loop-value-2
            set {_mu} to {_member}'s uuid
            if {bridge::return::%{_mu}%::instance} is {_inst}:
                if {bridge::return::%{_mu}%::match_id} is {_closingId}:
                    delete {bridge::return::%{_mu}%::*}
    delete {bridge::instance::%{_inst}%::resume_active}

    set {bridge::instance::%{_inst}%::state} to "CELEBRATION"
    set {bridge::instance::%{_inst}%::closing_id} to {_closingId}
    delete {bridge::instance::%{_inst}%::match_id}

    remove {_inst} from {bridge::core::active_instances::*}
    bridge_removeCage({_inst})

    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        set {_resultUUID} to loop-value's uuid
        if {bridge::instance::%{_inst}%::members::%{_resultUUID}%::result_recorded} is not true:
            bridge_addStat(loop-value, "games", 1)
            if {_winnerTeam} is 1:
                bridge_addStat(loop-value, "wins", 1)
            else if {_winnerTeam} is 2:
                bridge_addStat(loop-value, "losses", 1)
            set {bridge::instance::%{_inst}%::members::%{_resultUUID}%::result_recorded} to true

    loop {bridge::instance::%{_inst}%::team::2::players::*}:
        set {_resultUUID} to loop-value's uuid
        if {bridge::instance::%{_inst}%::members::%{_resultUUID}%::result_recorded} is not true:
            bridge_addStat(loop-value, "games", 1)
            if {_winnerTeam} is 2:
                bridge_addStat(loop-value, "wins", 1)
            else if {_winnerTeam} is 1:
                bridge_addStat(loop-value, "losses", 1)
            set {bridge::instance::%{_inst}%::members::%{_resultUUID}%::result_recorded} to true

    set {_arena} to {bridge::instance::%{_inst}%::arena}
    if {_winnerTeam} > 0:
        set {_winColorData} to {bridge::arena::%{_arena}%::team::%{_winnerTeam}%::color}
        set {_winTeamName} to bridge_getTeamName({_winColorData})
        set {_msgEnd} to "%{bridge::config::prefix}% &aFIM DE PARTIDA %{_winTeamName}% &7venceu a partida!"
        set {_subEnd} to "&7O %{_winTeamName}% &7venceu a partida!"
    else:
        set {_msgEnd} to "%{bridge::config::prefix}% &eFIM DE PARTIDA &7A partida terminou em &e&lEMPATE&7!"
        set {_subEnd} to "&7A partida terminou em EMPATE!"

    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            bridge_coreTitle(loop-value, "&aFIM DE PARTIDA!", {_subEnd}, 60)
            send {_msgEnd} to loop-value
    loop {bridge::instance::%{_inst}%::team::2::players::*}:
        if bridge_isPresent(loop-value, {_inst}) is true:
            bridge_coreTitle(loop-value, "&aFIM DE PARTIDA!", {_subEnd}, 60)
            send {_msgEnd} to loop-value

    wait 4 seconds

    if {bridge::instance::%{_inst}%::closing_id} is not {_closingId}:
        stop

    set {bridge::instance::%{_inst}%::state} to "RESETTING"
    set {_lobby} to {bridge::config::lobby}

    loop {bridge::instance::%{_inst}%::team::1::players::*}:
        set {_p} to loop-value
        if {bridge::player::%{_p}'s uuid%::instance} is {_inst}:
            if {_p} is online:
                clear {_p}'s inventory
                {_p}.setHealth(20.0)
                {_p}.setFoodLevel(20)
                {_p}.setFallDistance(0)
                set {_zero} to new Vector(0, 0, 0)
                {_p}.setVelocity({_zero})
                
                remove regeneration from {_p}
                remove absorption from {_p}
                
                set {_inv} to {_p}.getInventory()
                {_inv}.setHelmet(null)
                {_inv}.setChestplate(null)
                {_inv}.setLeggings(null)
                {_inv}.setBoots(null)
                
                teleport {_p} to {_lobby}
                set {_p}'s gamemode to adventure
            delete {bridge::player::%{_p}'s uuid%::match_kills}
            delete {bridge::player::%{_p}'s uuid%::match_goals}
            delete {bridge::player::%{_p}'s uuid%::*}

    loop {bridge::instance::%{_inst}%::team::2::players::*}:
        set {_p} to loop-value
        if {bridge::player::%{_p}'s uuid%::instance} is {_inst}:
            if {_p} is online:
                clear {_p}'s inventory
                {_p}.setHealth(20.0)
                {_p}.setFoodLevel(20)
                {_p}.setFallDistance(0)
                set {_zero} to new Vector(0, 0, 0)
                {_p}.setVelocity({_zero})
                
                remove regeneration from {_p}
                remove absorption from {_p}
                
                set {_inv} to {_p}.getInventory()
                {_inv}.setHelmet(null)
                {_inv}.setChestplate(null)
                {_inv}.setLeggings(null)
                {_inv}.setBoots(null)
                
                teleport {_p} to {_lobby}
                set {_p}'s gamemode to adventure
            delete {bridge::player::%{_p}'s uuid%::match_kills}
            delete {bridge::player::%{_p}'s uuid%::match_goals}
            delete {bridge::player::%{_p}'s uuid%::*}

    delete {bridge::instance::%{_inst}%::time_remaining}
    delete {bridge::instance::%{_inst}%::time_initial}
    delete {bridge::instance::%{_inst}%::time_notices::*}
    delete {bridge::instance::%{_inst}%::frozen}
    delete {bridge::instance::%{_inst}%::in_pause}
    delete {bridge::instance::%{_inst}%::pause_resume_votes::*}
    delete {bridge::instance::%{_inst}%::resume_kind}
    delete {bridge::instance::%{_inst}%::pause_request_team}
    delete {bridge::instance::%{_inst}%::pause_timer}
    delete {bridge::instance::%{_inst}%::freeze_reason}
    delete {bridge::instance::%{_inst}%::freeze_player_name}
    delete {bridge::instance::%{_inst}%::freeze_timer}
    delete {bridge::instance::%{_inst}%::freeze_team}
    delete {bridge::instance::%{_inst}%::resume_active}
    delete {bridge::instance::%{_inst}%::golden_goal}
    delete {bridge::instance::%{_inst}%::golden_goal_voted}
    delete {bridge::instance::%{_inst}%::pauses::1}
    delete {bridge::instance::%{_inst}%::pauses::2}
    delete {bridge::instance::%{_inst}%::voting::*}
    delete {bridge::instance::%{_inst}%::team::1::players::*}
    delete {bridge::instance::%{_inst}%::team::2::players::*}
    delete {bridge::instance::%{_inst}%::placed_blocks::*}

    delete {bridge::instance::%{_inst}%::members::*}
    delete {bridge::instance::%{_inst}%::team::1::initial_size}
    delete {bridge::instance::%{_inst}%::team::2::initial_size}
    set {_ok} to bridge_resetInstance({_inst})
    delete {bridge::instance::%{_inst}%::closing_id}

    if {_ok} is true:
        set {bridge::instance::%{_inst}%::state} to "IDLE"
    else:
        remove {_inst} from {bridge::instances::free::*}
        set {bridge::instance::%{_inst}%::state} to "DISABLED"

# Somente reserva efetiva de nova sessão encerra o vínculo anterior.
function bridge_registerDefinitiveAbandon(p: player):
    set {_u} to {_p}'s uuid
    set {_oldInst} to {bridge::return::%{_u}%::instance}
    set {_oldSid} to {bridge::return::%{_u}%::match_id}
    if {_oldInst} is not set:
        stop
    if {_oldSid} is not set:
        stop
    if {bridge::instance::%{_oldInst}%::match_id} is not {_oldSid}:
        stop
    if {bridge::instance::%{_oldInst}%::members::%{_u}%::match_id} is not {_oldSid}:
        stop
    if {bridge::instance::%{_oldInst}%::members::%{_u}%::result_recorded} is true:
        stop
    bridge_addStat({_p}, "games", 1)
    bridge_addStat({_p}, "losses", 1)
    set {bridge::instance::%{_oldInst}%::members::%{_u}%::result_recorded} to true
    set {bridge::instance::%{_oldInst}%::members::%{_u}%::individual_result} to "ABANDON"
