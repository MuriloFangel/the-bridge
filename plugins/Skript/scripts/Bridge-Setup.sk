# ---------------------------------------------------------
# HELPER DE ITEM VIA BUKKIT API (BLINDADO CONTRA ERROS DE SKRIPT)
# ---------------------------------------------------------
function bridge_makeItem(mat: text, data: integer, name: text, l1: text = "", l2: text = "", l3: text = "", l4: text = "", l5: text = "", l6: text = "") :: object:
    set {_m} to Material.valueOf({_mat})
    set {_item} to new ItemStack({_m}, 1)
    if {_data} > 0:
        {_item}.setDurability({_data})
    set {_meta} to {_item}.getItemMeta()
    if {_name} is set:
        {_meta}.setDisplayName({_name})
    set {_lore} to new ArrayList()
    if {_l1} is not "":
        {_lore}.add({_l1})
    if {_l2} is not "":
        {_lore}.add({_l2})
    if {_l3} is not "":
        {_lore}.add({_l3})
    if {_l4} is not "":
        {_lore}.add({_l4})
    if {_l5} is not "":
        {_lore}.add({_l5})
    if {_l6} is not "":
        {_lore}.add({_l6})
    if {_lore}.size() > 0:
        {_meta}.setLore({_lore})
    {_item}.setItemMeta({_meta})
    return {_item}

# ---------------------------------------------------------
# SISTEMA DE MENUS VISUAIS (BUKKIT API / SKRIPT-REFLECT)
# ---------------------------------------------------------
function bridge_openMainMenu(p: player):
    set {_inv} to Bukkit.createInventory(null, 36, "§8The Bridge - Arenas Cadastradas")
    bridge_menuBind({_p}, {_inv}, "ADMIN_LIST")
    set {_slot} to 0
    loop {bridge::arenas::*}:
        if {_slot} >= 36:
            exit loop
        set {_a} to loop-value
        set {_world} to {bridge::arena::%{_a}%::world}
        set {_axis} to {bridge::arena::%{_a}%::axis}
        set {_gols} to {bridge::arena::%{_a}%::gols}
        set {_tempo} to {bridge::arena::%{_a}%::tempo}
        set {_tempoMin} to floor({_tempo} / 60)
        set {_instances} to size of {bridge::arena::%{_a}%::instances::*}

        set {_item} to bridge_makeItem("PAPER", 0, "§a§lArena: §f%{_a}%", " §7- Eixo: §e%{_axis}% §7| Mundo: §e%{_world}%", " §7- Instâncias Alocadas: §a%{_instances}%", " §7- Gols: §f%{_gols}% §7| Tempo: §f%{_tempoMin}% min", "", "§eClique Esquerdo: §fTeleportar ao centro", "§bClique Direito: §fAbrir Editor Visual")
        {_inv}.setItem({_slot}, {_item})
        set {-bridge::menu::%{_p}'s uuid%::slots::%{_slot}%} to {_a}
        add 1 to {_slot}

    if size of {bridge::arenas::*} is 0:
        set {_barrier} to bridge_makeItem("BARRIER", 0, "§c§lNenhuma Arena Cadastrada", "§7Use §f/bridge setuparena <nome> §7para criar uma.")
        {_inv}.setItem(13, {_barrier})

    {_p}.openInventory({_inv})

function bridge_openEditor(p: player, arena: text):
    set {_inv} to Bukkit.createInventory(null, 36, "§8Gerenciar: %{_arena}%")
    bridge_menuBind({_p}, {_inv}, "ADMIN_EDITOR", {_arena})

    set {_gols} to {bridge::arena::%{_arena}%::gols}
    set {_tempo} to {bridge::arena::%{_arena}%::tempo}
    set {_tempoMin} to floor({_tempo} / 60)
    set {_yvoid} to {bridge::arena::%{_arena}%::y-void}
    set {_ymax} to {bridge::arena::%{_arena}%::y-max}
    set {_lponte} to {bridge::arena::%{_arena}%::limite-ponte}
    set {_llat} to {bridge::arena::%{_arena}%::limite-lateral}

    {_inv}.setItem(10, bridge_makeItem("NETHER_STAR", 0, "§a§lMeta de Gols", " §7- Valor Atual: §f%{_gols}%", "", "§eClique para editar este valor!"))
    {_inv}.setItem(11, bridge_makeItem("WATCH", 0, "§a§lTempo de Partida", " §7- Valor Atual: §f%{_tempoMin}% min §7(%{_tempo}%s)", "", "§eClique para editar este valor!"))
    {_inv}.setItem(12, bridge_makeItem("BEDROCK", 0, "§a§lY do Void", " §7- Valor Atual: §fY=%{_yvoid}%", "", "§eClique para editar este valor!"))
    {_inv}.setItem(13, bridge_makeItem("LADDER", 0, "§a§lAltura Máxima (Y-Max)", " §7- Valor Atual: §fY=%{_ymax}%", "", "§eClique para editar este valor!"))
    {_inv}.setItem(14, bridge_makeItem("FENCE", 0, "§a§lLimite Longitudinal", " §7- Valor Atual: §f%{_lponte}% blocos do centro", "", "§eClique para editar este valor!"))
    {_inv}.setItem(15, bridge_makeItem("IRON_FENCE", 0, "§a§lLimite Lateral", " §7- Valor Atual: §f%{_llat}% blocos para cada lado", "", "§eClique para editar este valor!"))

    {_inv}.setItem(31, bridge_makeItem("ARROW", 0, "§c§lVoltar ao Menu Principal"))

    {_p}.openInventory({_inv})

function bridge_openModifier(p: player, arena: text, prop: text, title: text, val: number):
    set {_inv} to Bukkit.createInventory(null, 36, "§8Editar: %{_arena}% > %{_title}%")
    bridge_menuBind({_p}, {_inv}, "ADMIN_VALUE", {_arena}, {_prop})

    if {_prop} is "tempo":
        set {_valMin} to floor({_val} / 60)
        {_inv}.setItem(10, bridge_makeItem("WOOL", 14, "§c§lDiminuir (-5 min)"))
        {_inv}.setItem(11, bridge_makeItem("STAINED_GLASS_PANE", 14, "§c§lDiminuir (-1 min)"))
        {_inv}.setItem(13, bridge_makeItem("BOOK", 0, "§e§lValor Atual: §f%{_valMin}% min", " §7Arena: §f%{_arena}%", " §7Propriedade: §f%{_prop}%"))
        {_inv}.setItem(15, bridge_makeItem("STAINED_GLASS_PANE", 5, "§a§lAumentar (+1 min)"))
        {_inv}.setItem(16, bridge_makeItem("WOOL", 5, "§a§lAumentar (+5 min)"))
        {_inv}.setItem(22, bridge_makeItem("PAPER", 0, "§e§lDigitar Valor Manualmente", "§7Clique para fechar o menu e", "§7digitar os minutos no chat."))
    else:
        {_inv}.setItem(10, bridge_makeItem("WOOL", 14, "§c§lDiminuir (-5)"))
        {_inv}.setItem(11, bridge_makeItem("STAINED_GLASS_PANE", 14, "§c§lDiminuir (-1)"))
        {_inv}.setItem(13, bridge_makeItem("BOOK", 0, "§e§lValor Atual: §f%{_val}%", " §7Arena: §f%{_arena}%", " §7Propriedade: §f%{_prop}%"))
        {_inv}.setItem(15, bridge_makeItem("STAINED_GLASS_PANE", 5, "§a§lAumentar (+1)"))
        {_inv}.setItem(16, bridge_makeItem("WOOL", 5, "§a§lAumentar (+5)"))
        {_inv}.setItem(22, bridge_makeItem("PAPER", 0, "§e§lDigitar Valor Manualmente", "§7Clique para fechar o menu e", "§7digitar o número exato no chat."))

    if {_prop} is "y-void" or "y-max":
        set {_yCurr} to floor(y-coordinate of {_p}'s location)
        {_inv}.setItem(24, bridge_makeItem("COMPASS", 0, "§b§lUsar minha Altura Atual (Y=%{_yCurr}%)", "§7Clique para salvar sua altura Y atual."))
    else if {_prop} is "limite-ponte":
        set {_axis} to {bridge::arena::%{_arena}%::axis}
        if {_axis} is "X":
            set {_d} to abs(floor(x-coordinate of {_p}'s location))
        else:
            set {_d} to abs(floor(z-coordinate of {_p}'s location))
        {_inv}.setItem(24, bridge_makeItem("COMPASS", 0, "§b§lUsar minha Posição Atual (%{_d}%b)", "§7Clique para salvar sua distância atual do centro."))

    {_inv}.setItem(31, bridge_makeItem("ARROW", 0, "§c§lVoltar ao Editor"))

    {_p}.openInventory({_inv})

# ---------------------------------------------------------
# MENSAGENS INTERATIVAS E FORMATAÇÃO LIMPA (TELLRAW)
# ---------------------------------------------------------
function bridge_tellrawCmd(p: player, cmd: text, desc: text, isSuggest: boolean):
    set {_action} to "run_command"
    if {_isSuggest} is true:
        set {_action} to "suggest_command"
    execute console command "tellraw %{_p}% {""text"":""  §f%{_cmd}%"",""clickEvent"":{""action"":""%{_action}%"",""value"":""%{_cmd}%""}}"
    send "    &7%{_desc}%" to {_p}

function bridge_sendHeader(p: player, title: text):
    send "" to {_p}
    send "§8§m----------------------------------------" to {_p}
    send " &9&lTHE BRIDGE §8» §f%{_title}%" to {_p}
    send "" to {_p}

function bridge_sendFooter(p: player):
    send "" to {_p}
    send "§8§m----------------------------------------" to {_p}

# ---------------------------------------------------------
# CANCELAR OU RECEBER INPUT VIA CHAT
# ---------------------------------------------------------
on chat:
    set {_u} to player's uuid
    if {bridge::chat_edit::%{_u}%::arena} is not set:
        stop
    cancel event
    set {_p} to player
    set {_arena} to {bridge::chat_edit::%{_u}%::arena}
    set {_prop} to {bridge::chat_edit::%{_u}%::prop}
    set {_revision} to {bridge::chat_edit::%{_u}%::revision}
    set {_input} to message
    delete {bridge::chat_edit::%{_u}%::*}
    # A mensagem pode vir de AsyncPlayerChatEvent; inventários só no tick seguinte.
    wait 1 tick
    if {_p} is not online:
        stop
    if {_revision} is not set:
        stop
    if {-bridge::ui_revision::%{_u}%} is not {_revision}:
        stop
    if {_p}.hasPermission("bridge.admin") is false:
        send "%{bridge::config::erro}% &cVocê não tem mais permissão para editar arenas." to {_p}
        stop
    if {bridge::arenas::*} does not contain {_arena}:
        stop
    if {_input} is "cancelar" or "cancel":
        send "%{bridge::config::prefix}% &cEdição cancelada." to {_p}
        bridge_openEditor({_p}, {_arena})
        stop
    set {_value} to {_input} parsed as integer
    if {_value} is not set:
        send "%{bridge::config::erro}% &cDigite um número inteiro. Nenhum valor foi alterado." to {_p}
        bridge_openEditor({_p}, {_arena})
        stop
    if {_prop} is "tempo":
        set {_value} to {_value} * 60
    set {_ok} to bridge_configApply({_p}, {_arena}, {_prop}, {_value})
    bridge_openEditor({_p}, {_arena})

# ---------------------------------------------------------
# GERENCIAMENTO DOS CLIQUES NOS MENUS (BUKKIT EVENT)
# ---------------------------------------------------------
on inventory click with priority lowest:
    set {_p} to player
    set {_u} to {_p}'s uuid
    set {_inv} to {-bridge::menu::%{_u}%::inventory}
    if {_inv} is not set:
        stop
    set {_top} to event.getView().getTopInventory()
    if {_top}.equals({_inv}) is false:
        stop
    cancel event
    set {_slot} to event.getRawSlot()
    if {_slot} < 0:
        stop
    if {_slot} >= {_inv}.getSize():
        stop
    set {_click} to event.getClick().name()
    if {_click} is not "LEFT":
        if {_click} is not "RIGHT":
            stop
    if {-bridge::menu::%{_u}%::busy} is true:
        stop
    set {_revision} to {-bridge::menu::%{_u}%::revision}
    set {-bridge::menu::%{_u}%::busy} to true
    wait 1 tick
    if {_p} is not online:
        stop
    if {-bridge::menu::%{_u}%::inventory} is not set:
        stop
    if {-bridge::menu::%{_u}%::revision} is not {_revision}:
        stop
    set {_current} to {_p}.getOpenInventory().getTopInventory()
    if {_current}.equals({_inv}) is false:
        stop
    set {-bridge::menu::%{_u}%::busy} to false
    bridge_menuAction({_p}, {_slot}, {_click})

# ---------------------------------------------------------
# COMANDO PRINCIPAL /BRIDGE
# ---------------------------------------------------------
# Catálogo de comandos implementados. Não anuncia parties, 2v2 ou /spec ainda ausentes.
function bridge_showHelp(p: player, page: text = "geral"):
    bridge_sendHeader({_p}, "Ajuda &8| &f%{_page}%")
    if {_page} is "geral":
        send " &7Clique numa categoria. TAB também sugere os comandos existentes." to {_p}
        bridge_tellrawCmd({_p}, "/bridge ajuda jogo", "Entrar, sair, retornar e consultar perfil", false)
        bridge_tellrawCmd({_p}, "/bridge ajuda votos", "Pedir pausa, votar e antecipar retomada", false)
        bridge_tellrawCmd({_p}, "/bridge ajuda arena", "Cadastrar molde, spawns, cages e limites", false)
        bridge_tellrawCmd({_p}, "/bridge ajuda admin", "Lobby, menu, reset de instância e footer", false)
    else if {_page} is "jogo":
        bridge_tellrawCmd({_p}, "/arenas", "Abre o seletor de arenas", false)
        bridge_tellrawCmd({_p}, "/jogar [arena]", "Entra na fila 1v1; aliases: /play e /join", true)
        bridge_tellrawCmd({_p}, "/l", "Sai da fila ou vai ao lobby; retorno quando disponível", false)
        bridge_tellrawCmd({_p}, "/retornar", "Volta à sessão vinculada pelo spawn do time", false)
        bridge_tellrawCmd({_p}, "/stats [jogador]", "Consulta perfil salvo; aliases: /status e /perfil", true)
        send " &7Entrar efetivamente em outra partida encerra o retorno à anterior." to {_p}
    else if {_page} is "votos":
        bridge_tellrawCmd({_p}, "/pausa", "Solicita pausa: precisa de SIM dos dois times", false)
        bridge_tellrawCmd({_p}, "/bridgevote <sim|nao>", "Vota na consulta aberta; o primeiro voto é definitivo", true)
        bridge_tellrawCmd({_p}, "/despausar", "Só o time solicitante vota; exige mais da metade", false)
        send " &7O pedido já conta como SIM de quem solicitou." to {_p}
        send " &7Pedido em votação não para a jogada nem o relógio." to {_p}
        send " &7Prazo máximo: 30s; resultado definido executa antes." to {_p}
    else if {_page} is "arena":
        bridge_tellrawCmd({_p}, "/bridge setuparena <nome>", "Escaneia o molde e substitui seu cadastro", true)
        bridge_tellrawCmd({_p}, "/bridge setcage <arena> <1|2>", "Salva sua posição como cage daquele time", true)
        bridge_tellrawCmd({_p}, "/bridge setlimitpos <arena>", "Usa sua distância ao centro no eixo da ponte", true)
        bridge_tellrawCmd({_p}, "/bridge setlimit <arena> <ponte|lateral> <valor>", "Distância em blocos do centro para CADA lado", true)
        bridge_tellrawCmd({_p}, "/bridge set <arena> <propriedade> <valor>", "Regras da arena; tempo aqui é em SEGUNDOS", true)
        send " &7Propriedades: gols, tempo, y-void, y-max," to {_p}
        send " &7limite-ponte e limite-lateral. Não confunda cópia com área construível." to {_p}
        send " &cCadastro pode substituir dados anteriores. Use sem partidas ativas." to {_p}
    else if {_page} is "admin":
        bridge_tellrawCmd({_p}, "/bridgelobby", "Define sua posição atual como lobby do Bridge", false)
        bridge_tellrawCmd({_p}, "/bridge menu", "Abre o editor das arenas cadastradas", false)
        bridge_tellrawCmd({_p}, "/bridge tp <arena> [centro|t1|t2]", "Visita o molde original, não uma partida", true)
        bridge_tellrawCmd({_p}, "/bridgereset <instância>", "Restaura a cópia; não use em partida ativa", true)
        bridge_tellrawCmd({_p}, "/bridgescoreboard setfooter <endereço>", "Altera e salva o endereço no rodapé da sidebar", true)
        bridge_tellrawCmd({_p}, "/bridgeguardian [check|status|detalhes]", "Confere arquivos obrigatórios e funções registradas", true)
        send " &7O clima é gerenciado nos mundos das arenas e do lobby configurado." to {_p}
    else:
        send " &cCategoria inválida. Use: jogo, votos, arena ou admin." to {_p}
    bridge_sendFooter({_p})

command /bridge [<text>] [<text>] [<text>] [<text>]:
    permission: bridge.admin
    permission message: &cVocê não tem permissão.
    trigger:
        if executor is not a player:
            if arg-1 is not "set":
                if arg-1 is not "setlimit":
                    send "&cNo console, use /bridge set ou /bridge setlimit. As demais ações precisam de jogador/posição/menu." to executor
                    stop
        if arg-1 is not set:
            bridge_showHelp(player)
            stop
        if arg-1 is "ajuda" or "help":
            set {_page} to arg-2
            if {_page} is not set:
                set {_page} to "geral"
            bridge_showHelp(player, {_page})
            stop

        # ---------------------------------------------------------
        # SETUP E ESCANEAMENTO DA ARENA
        # ---------------------------------------------------------
        if arg-1 is "setuparena":
            if arg-2 is not set:
                bridge_tellrawCmd(player, "/bridge setuparena <nome>", "Sintaxe correta", true)
                stop
            
            set {_name} to arg-2
            if {_name}.matches("[A-Za-z0-9_-]+") is false:
                send "%{bridge::config::erro}% &cUse letras sem acentos, números, hífen ou sublinhado no nome da arena." to player
                stop
            if bridge_setupArenaBusy({_name}) is true:
                send "%{bridge::config::erro}% &cCadastro recusado: há instância em uso, transição ou operação pendente nesta arena." to player
                stop
            set {_w} to player's world
            
            send "%{bridge::config::prefix}% &eCadastro &8| &f%{_name}% &7no mundo %{_w}%" to player
            send " &cEste cadastro substitui dados anteriores do mesmo nome." to player
            send "[Bridge] Setup da arena %{_name}% no mundo %{_w}%..." to console

            delete {_sponges::*}
            delete {_portals::*}

            set {_cX} to 0
            set {_cY} to 93
            set {_cZ} to 0
            set {_origin} to location at 0.5, 94, 0.5 in {_w}

            set {_axis} to "X"
            set {_t1_color} to 11
            set {_t2_color} to 14

            set {_bNegX} to (location at -1, 93, 0 in {_w}).getBlock()
            set {_bPosX} to (location at 1, 93, 0 in {_w}).getBlock()
            set {_bNegZ} to (location at 0, 93, -1 in {_w}).getBlock()
            set {_bPosZ} to (location at 0, 93, 1 in {_w}).getBlock()

            if {_bNegX}.getType().getId() is 159:
                set {_axis} to "X"
                if {_bNegX}.getData() is not 0:
                    set {_t1_color} to {_bNegX}.getData()
                if {_bPosX}.getType().getId() is not 0:
                    set {_t2_color} to {_bPosX}.getData()
            else if {_bNegZ}.getType().getId() is 159:
                set {_axis} to "Z"
                if {_bNegZ}.getData() is not 0:
                    set {_t1_color} to {_bNegZ}.getData()
                if {_bPosZ}.getType().getId() is not 0:
                    set {_t2_color} to {_bPosZ}.getData()

            if {_axis} is "X":
                set {_minX} to -80
                set {_maxX} to 80
                set {_minZ} to -5
                set {_maxZ} to 5
            else:
                set {_minX} to -5
                set {_maxX} to 5
                set {_minZ} to -80
                set {_maxZ} to 80

            set {_countX} to ({_maxX} - {_minX}) + 1
            set {_countZ} to ({_maxZ} - {_minZ}) + 1

            loop {_countX} times:
                set {_x} to ({_minX} - 1) + loop-value
                loop 31 times:
                    set {_y} to 79 + loop-value-2
                    loop {_countZ} times:
                        set {_z} to ({_minZ} - 1) + loop-value-3
                        set {_id} to {_w}.getBlockTypeIdAt({_x}, {_y}, {_z})
                        
                        if {_id} is 19:
                            set {_loc} to location at {_x}, {_y}, {_z} in {_w}
                            if {_loc}.getBlock().getData() is 1:
                                add {_loc} to {_sponges::*}
                        else if {_id} is 119:
                            set {_loc} to location at {_x}, {_y}, {_z} in {_w}
                            add {_loc} to {_portals::*}

            if size of {_sponges::*} is not 2:
                send "%{bridge::config::erro}% &cEscaneamento falhou! Encontradas &f%size of {_sponges::*}% &cesponjas molhadas. Necessárias: 2." to player
                stop
                
            if size of {_portals::*} is 0:
                send "%{bridge::config::erro}% &cEscaneamento falhou! Nenhum bloco de portal encontrado." to player
                stop

            set {_rawS1} to {_sponges::1}
            set {_rawS2} to {_sponges::2}
            
            if {_axis} is "X":
                if x-coordinate of {_rawS1} < x-coordinate of {_rawS2}:
                    set {_s1_raw} to {_rawS1}
                    set {_s2_raw} to {_rawS2}
                else:
                    set {_s1_raw} to {_rawS2}
                    set {_s2_raw} to {_rawS1}
            else:
                if z-coordinate of {_rawS1} < z-coordinate of {_rawS2}:
                    set {_s1_raw} to {_rawS1}
                    set {_s2_raw} to {_rawS2}
                else:
                    set {_s1_raw} to {_rawS2}
                    set {_s2_raw} to {_rawS1}

            set {_s1_x} to floor(x-coordinate of {_s1_raw}) + 0.5
            set {_s1_y} to y-coordinate of {_s1_raw} + 1.0
            set {_s1_z} to floor(z-coordinate of {_s1_raw}) + 0.5
            set {_t1_sponge} to location at {_s1_x}, {_s1_y}, {_s1_z} in {_w}
            set pitch of {_t1_sponge} to 0

            set {_s2_x} to floor(x-coordinate of {_s2_raw}) + 0.5
            set {_s2_y} to y-coordinate of {_s2_raw} + 1.0
            set {_s2_z} to floor(z-coordinate of {_s2_raw}) + 0.5
            set {_t2_sponge} to location at {_s2_x}, {_s2_y}, {_s2_z} in {_w}
            set pitch of {_t2_sponge} to 0

            if {_axis} is "X":
                set yaw of {_t1_sponge} to -90
                set yaw of {_t2_sponge} to 90
            else:
                set yaw of {_t1_sponge} to 0
                set yaw of {_t2_sponge} to 180

            # Só a sessão ativa do WorldEdit pode produzir uma clipboard nova.
            set {_wePlugin} to Bukkit.getPluginManager().getPlugin("WorldEdit")
            if {_wePlugin} is not set:
                send "%{bridge::config::erro}% &cWorldEdit indisponível. Cadastro anterior preservado." to player
                stop
            set {_weSession} to try {_wePlugin}.getSession(player)
            if {_weSession} is not set:
                send "%{bridge::config::erro}% &cNão foi possível obter a sessão WorldEdit. Nada substituído." to player
                stop
            if bridge_setupArenaBusy({_name}) is true:
                send "%{bridge::config::erro}% &cA arena ficou ocupada. Cadastro anterior preservado." to player
                stop
            set {_token} to BridgeSetupUUID.randomUUID().toString()
            set {_candidateName} to "bridge_%{_name}%__candidate_%{_token}%"
            set {_faweCandidate} to new File("plugins/FastAsyncWorldEdit/schematics/%{_candidateName}%.schematic")
            set {_weCandidate} to new File("plugins/WorldEdit/schematics/%{_candidateName}%.schematic")
            if {_faweCandidate}.exists() is true:
                stop
            if {_weCandidate}.exists() is true:
                stop
            set {-bridge::setup::%{_name}%::active} to true
            set {-bridge::setup::%{_name}%::token} to {_token}
            loop {bridge::arena::%{_name}%::instances::*}:
                if {bridge::instances::free::*} contains loop-value:
                    add loop-value to {-bridge::setup::%{_name}%::saved_free::*}
                    remove loop-value from {bridge::instances::free::*}
            set {_old_loc} to player's location
            set {_previousClipboard} to try {_weSession}.getClipboard()
            if {_previousClipboard} is not set:
                set {_previousClipboard} to false
            {_weSession}.setClipboard(null)
            teleport player to {_origin}
            wait 5 ticks
            if player is not online:
                bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                stop
            make player execute command "/wea"
            wait 2 ticks
            make player execute command "//pos1 -80,60,-80"
            wait 2 ticks
            make player execute command "//pos2 80,140,80"
            wait 2 ticks
            make player execute command "//copy"
            set {_waited} to 0
            delete {_freshHolder}
            while {_freshHolder} is not set:
                set {_freshHolder} to try {_weSession}.getClipboard()
                if {_freshHolder} is set:
                    exit loop
                wait 10 ticks
                add 0.5 to {_waited}
                if player is not online:
                    bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                    stop
                if {_waited} >= 30:
                    send "[Bridge] Setup %{_name}%: cópia não concluiu em 30s; cadastro anterior preservado." to console
                    bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                    stop
            # Preserva também a espera mínima usada pelo fluxo anterior.
            wait 3 seconds
            if player is not online:
                bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                stop
            set {_currentHolder} to try {_weSession}.getClipboard()
            if {_currentHolder} is not {_freshHolder}:
                send "%{bridge::config::erro}% &cA clipboard mudou durante a cópia. Cadastro anterior preservado." to player
                bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                stop
            # Evita anunciar sucesso com uma cópia de outra seleção.
            set {_freshClip} to {_freshHolder}.getClipboard()
            set {_freshRegion} to {_freshClip}.getRegion()
            set {_freshMin} to {_freshRegion}.getMinimumPoint()
            set {_freshMax} to {_freshRegion}.getMaximumPoint()
            set {_selectionOk} to true
            if {_freshMin}.getBlockX() is not -80:
                set {_selectionOk} to false
            if {_freshMin}.getBlockY() is not 60:
                set {_selectionOk} to false
            if {_freshMin}.getBlockZ() is not -80:
                set {_selectionOk} to false
            if {_freshMax}.getBlockX() is not 80:
                set {_selectionOk} to false
            if {_freshMax}.getBlockY() is not 140:
                set {_selectionOk} to false
            if {_freshMax}.getBlockZ() is not 80:
                set {_selectionOk} to false
            if {_selectionOk} is not true:
                send "%{bridge::config::erro}% &cA cópia não corresponde ao volume do molde. Cadastro anterior preservado." to player
                bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                stop
            make player execute command "//schem save %{_candidateName}% -g"
            set {_waited} to 0
            delete {_candidate}
            while {_candidate} is not set:
                if bridge_setupSchematicValid({_faweCandidate}, {_w}) is true:
                    set {_candidate} to {_faweCandidate}
                else if bridge_setupSchematicValid({_weCandidate}, {_w}) is true:
                    set {_candidate} to {_weCandidate}
                if {_candidate} is set:
                    exit loop
                wait 10 ticks
                add 0.5 to {_waited}
                if player is not online:
                    bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                    stop
                if {_waited} >= 30:
                    send "[Bridge] Setup %{_name}%: candidata não validou em 30s; arquivo anterior preservado." to console
                    bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                    stop
            if {-bridge::setup::%{_name}%::token} is not {_token}:
                send "[Bridge] Setup %{_name}% perdeu a identidade da operação. Sem promoção de arquivo." to console
                stop
            set {_faweTarget} to new File("plugins/FastAsyncWorldEdit/schematics/bridge_%{_name}%.schematic")
            set {_weTarget} to new File("plugins/WorldEdit/schematics/bridge_%{_name}%.schematic")
            if {_faweTarget}.exists() is true:
                set {_target} to {_faweTarget}
            else if {_weTarget}.exists() is true:
                set {_target} to {_weTarget}
            else:
                set {_parent} to {_candidate}.getParentFile()
                set {_target} to new File({_parent}, "bridge_%{_name}%.schematic")
            set {_promoted} to bridge_setupPromote({_candidate}, {_target}, {_token})
            if {_promoted} is not true:
                send "%{bridge::config::erro}% &cNão foi possível promover a nova schematic. Confira o console; cadastro não substituído." to player
                bridge_setupAbort({_name}, {_token}, {_weSession}, {_previousClipboard}, player, {_old_loc})
                stop
            teleport player to {_old_loc}
            # A partir daqui não há mais espera até terminar a troca do cadastro.
            # Não restaurar as instâncias antigas à lista livre na confirmação.
            bridge_setupUnlock({_name}, {_token}, false)

            loop {bridge::arena::%{_name}%::instances::*}:
                delete {bridge::instance::%loop-value%::*}
                remove loop-value from {bridge::instances::free::*}
            
            delete {bridge::arena::%{_name}%::*}
            
            if {bridge::arenas::*} does not contain {_name}:
                add {_name} to {bridge::arenas::*}

            set {bridge::arena::%{_name}%::world} to "%{_w}%"
            set {bridge::arena::%{_name}%::axis} to {_axis}
            set {bridge::arena::%{_name}%::center} to {_origin}
            set {bridge::arena::%{_name}%::team::1::color} to {_t1_color}
            set {bridge::arena::%{_name}%::team::1::sponge} to {_t1_sponge}
            set {bridge::arena::%{_name}%::team::2::color} to {_t2_color}
            set {bridge::arena::%{_name}%::team::2::sponge} to {_t2_sponge}

            loop {_portals::*}:
                set {_d1} to distance between loop-value and {_t1_sponge}
                set {_d2} to distance between loop-value and {_t2_sponge}
                if {_d1} < {_d2}:
                    add loop-value to {bridge::arena::%{_name}%::team::1::portals::*}
                else:
                    add loop-value to {bridge::arena::%{_name}%::team::2::portals::*}

            set {bridge::arena::%{_name}%::gols} to {bridge::config::default_gols}
            set {bridge::arena::%{_name}%::y-void} to {bridge::config::default_y_void}
            set {bridge::arena::%{_name}%::y-max} to {bridge::config::default_y_max}
            set {bridge::arena::%{_name}%::tempo} to {bridge::config::default_tempo}
            set {bridge::arena::%{_name}%::limite-ponte} to {bridge::config::default_limite_ponte}
            set {bridge::arena::%{_name}%::limite-lateral} to {bridge::config::default_limite_lateral}

            # RELATÓRIO DO CHAT ESPAÇADO E FORMATADO
            bridge_sendHeader(player, "Resumo do cadastro &8| &f%{_name}%")
            send "  §7• §fEixo: §e%{_axis}% §8| §fMundo: §e%{_w}%" to player
            send "  §7• §fTime 1 (Cor %{_t1_color}%): §7Spawn em §f%{_s1_x}%, %{_s1_y}%, %{_s1_z}%" to player
            send "  §7• §fTime 2 (Cor %{_t2_color}%): §7Spawn em §f%{_s2_x}%, %{_s2_y}%, %{_s2_z}%" to player
            send "  §7• §fLimites de Construção: §7Ponte §f%{bridge::arena::%{_name}%::limite-ponte}%b §8| §7Lateral/lado §f%{bridge::arena::%{_name}%::limite-lateral}%b" to player
            send "  §7• §fRegras: §7Gols §f%{bridge::arena::%{_name}%::gols}% §8| §7Tempo §f%{bridge::arena::%{_name}%::tempo}%s §8| §7Void Y §f%{bridge::arena::%{_name}%::y-void}%" to player
            send "" to player
            send "  §eAções rápidas:" to player
            execute console command "tellraw %player% {""text"":"""", ""extra"":[{""text"":""   §a§l[TP CENTRO]  "",""clickEvent"":{""action"":""run_command"",""value"":""/bridge tp %{_name}% centro""}},{""text"":""§a§l[TP SPAWN T1]  "",""clickEvent"":{""action"":""run_command"",""value"":""/bridge tp %{_name}% t1""}},{""text"":""§a§l[TP SPAWN T2]"",""clickEvent"":{""action"":""run_command"",""value"":""/bridge tp %{_name}% t2""}}]}"
            execute console command "tellraw %player% {""text"":"""", ""extra"":[{""text"":""   §b§l[SETAR LIMITE DE CONSTRUÇÃO NA SUA POSIÇÃO ATUAL]"",""clickEvent"":{""action"":""run_command"",""value"":""/bridge setlimitpos %{_name}%""}}]}"
            bridge_sendFooter(player)

            # Pré-alocação
            send "%{bridge::config::prefix}% &ePré-alocando 3 instâncias automáticas..." to player
            bridge_expandInstances({_name}, 3)
            set {_registered} to size of {bridge::arena::%{_name}%::instances::*}
            if {_registered} >= 3:
                send "%{bridge::config::sucesso}% &aPré-alocação: &f%{_registered}% &ainstâncias cadastradas. Confira o console para o resultado da colagem." to player
            else:
                send "%{bridge::config::erro}% &cPré-alocação incompleta: &f%{_registered}%/3&c. Verifique o console antes de abrir partidas." to player

        # ---------------------------------------------------------
        # SETAR LIMITE DE CONSTRUÇÃO DA PONTE PELA POSIÇÃO ATUAL
        # ---------------------------------------------------------
        else if arg-1 is "setlimitpos":
            if arg-2 is not set:
                bridge_tellrawCmd(player, "/bridge setlimitpos <arena>", "Sintaxe correta", true)
                stop
            set {_arena} to arg-2
            if {bridge::arena::%{_arena}%::axis} is not set:
                send "%{bridge::config::erro}% &cA arena '%{_arena}%' não existe." to player
                stop

            set {_axis} to {bridge::arena::%{_arena}%::axis}
            if {_axis} is "X":
                set {_dist} to abs(floor(x-coordinate of player's location))
            else:
                set {_dist} to abs(floor(z-coordinate of player's location))

            if {_dist} <= 0:
                send "%{bridge::config::erro}% &cAfaste-se do centro (0,0) para definir o limite." to player
                stop

            set {_ok} to bridge_configApply(executor, {_arena}, "limite-ponte", {_dist})

        # ---------------------------------------------------------
        # DEFINIR CAGE CUSTOMIZADA
        # ---------------------------------------------------------
        else if arg-1 is "setcage":
            if arg-2 is not set:
                bridge_tellrawCmd(player, "/bridge setcage <arena> <1|2>", "Sintaxe correta", true)
                stop
            if arg-3 != "1":
                if arg-3 != "2":
                    send "%{bridge::config::erro}% &cO time deve ser 1 ou 2." to player
                    stop
            set {_arena} to arg-2
            set {_team} to arg-3
            if {bridge::arena::%{_arena}%::axis} is not set:
                send "%{bridge::config::erro}% &cA arena '%{_arena}%' não existe." to player
                stop

            if {-bridge::setup::%{_arena}%::active} is true:
                send "%{bridge::config::erro}% &cAguarde o cadastro desta arena terminar." to player
                stop
            set {bridge::arena::%{_arena}%::team::%{_team}%::cage} to location of player
            send "%{bridge::config::sucesso}% &aCage customizada do Time %{_team}% definida em %player's location%." to player

        # ---------------------------------------------------------
        # DEFINIR LIMITES DE CONSTRUÇÃO
        # ---------------------------------------------------------
        else if arg-1 is "setlimit":
            set {_arena} to arg-2
            set {_type} to arg-3
            set {_value} to arg-4 parsed as integer
            if {_arena} is not set:
                send "&cUse: /bridge setlimit <arena> <ponte|lateral> <valor>" to executor
                stop
            if {_value} is not set:
                send "&cInforme um número inteiro." to executor
                stop
            if {_type} is "ponte" or "longitudinal":
                set {_prop} to "limite-ponte"
            else if {_type} is "lateral":
                set {_prop} to "limite-lateral"
            else:
                send "&cUse ponte ou lateral." to executor
                stop
            set {_ok} to bridge_configApply(executor, {_arena}, {_prop}, {_value})

        else if arg-1 is "set":
            set {_arena} to arg-2
            set {_prop} to arg-3
            set {_value} to arg-4 parsed as integer
            if {_arena} is not set:
                send "&cUse: /bridge set <arena> <propriedade> <valor>" to executor
                stop
            if {_prop} is not set:
                send "&cInforme a propriedade." to executor
                stop
            if {_value} is not set:
                send "&cInforme um número inteiro. Tempo neste comando é em segundos." to executor
                stop
            set {_ok} to bridge_configApply(executor, {_arena}, {_prop}, {_value})

        # ---------------------------------------------------------
        # TELEPORTE PARA A ARENA
        # ---------------------------------------------------------
        else if arg-1 is "tp":
            if arg-2 is not set:
                bridge_tellrawCmd(player, "/bridge tp <arena> [centro|t1|t2]", "Sintaxe correta", true)
                stop
            set {_arena} to arg-2
            set {_target} to arg-3
            
            if {bridge::arena::%{_arena}%::axis} is not set:
                send "%{bridge::config::erro}% &cA arena '%{_arena}%' não existe." to player
                stop

            if {_target} is "t1" or "1":
                teleport player to {bridge::arena::%{_arena}%::team::1::sponge}
                send "%{bridge::config::sucesso}% &aTeleportado para o spawn do Time 1 na arena &f%{_arena}%." to player
            else if {_target} is "t2" or "2":
                teleport player to {bridge::arena::%{_arena}%::team::2::sponge}
                send "%{bridge::config::sucesso}% &aTeleportado para o spawn do Time 2 na arena &f%{_arena}%." to player
            else:
                teleport player to {bridge::arena::%{_arena}%::center}
                send "%{bridge::config::sucesso}% &aTeleportado para o centro da arena &f%{_arena}%." to player

        # ---------------------------------------------------------
        # MENU GUI PRINCIPAL
        # ---------------------------------------------------------
        else if arg-1 is "menu" or "list" or "maps":
            bridge_openMainMenu(player)
        else:
            send "%{bridge::config::erro}% &cSubcomando desconhecido. Use &f/bridge ajuda&c." to player


# Sem alteração de geometria: somente proteção da operação de cadastro.
function bridge_setupArenaBusy(arena: text) :: boolean:
    if {-bridge::setup::%{_arena}%::active} is true:
        return true
    if {-bridge::instance_expanding::%{_arena}%} is true:
        return true
    loop {bridge::arena::%{_arena}%::instances::*}:
        if bridge_instanceBusy(loop-value) is true:
            return true
    loop {bridge::core::active_instances::*}:
        set {_id} to loop-value
        if {bridge::instance::%{_id}%::arena} is {_arena}:
            return true
    return false

function bridge_setupUnlock(arena: text, token: text, restoreFree: boolean):
    if {-bridge::setup::%{_arena}%::token} is not {_token}:
        stop
    if {_restoreFree} is true:
        loop {-bridge::setup::%{_arena}%::saved_free::*}:
            set {_id} to loop-value
            if {bridge::instance::%{_id}%::arena} is {_arena}:
                if {bridge::instance::%{_id}%::match_id} is not set:
                    if {bridge::instance::%{_id}%::closing_id} is not set:
                        if {bridge::instances::free::*} does not contain {_id}:
                            add {_id} to {bridge::instances::free::*}
    delete {-bridge::setup::%{_arena}%::*}

function bridge_setupAbort(arena: text, token: text, session: object, previous: object, p: player, origin: location):
    if {_previous} is false:
        {_session}.setClipboard(null)
    else:
        {_session}.setClipboard({_previous})
    if {_p} is online:
        teleport {_p} to {_origin}
    bridge_setupUnlock({_arena}, {_token}, true)

# Lê integralmente uma candidata nova; existir um arquivo antigo não aprova esta etapa.
function bridge_setupSchematicValid(file: object, w: object) :: boolean:
    if {_file}.isFile() is false:
        return false
    if {_file}.length() <= 0:
        return false
    set {_format} to try BridgeSetupFormat.findByFile({_file})
    if {_format} is not set:
        return false
    set {_stream} to try new BridgeSetupInput({_file})
    if {_stream} is not set:
        return false
    set {_reader} to try {_format}.getReader({_stream})
    if {_reader} is not set:
        {_stream}.close()
        return false
    set {_weWorld} to new BridgeSetupWorld({_w})
    set {_data} to {_weWorld}.getWorldData()
    set {_clip} to try {_reader}.read({_data})
    {_stream}.close()
    if {_clip} is not set:
        return false
    set {_region} to {_clip}.getRegion()
    set {_min} to {_region}.getMinimumPoint()
    set {_max} to {_region}.getMaximumPoint()
    set {_dx} to {_max}.getBlockX() - {_min}.getBlockX() + 1
    set {_dy} to {_max}.getBlockY() - {_min}.getBlockY() + 1
    set {_dz} to {_max}.getBlockZ() - {_min}.getBlockZ() + 1
    if {_dx} is not 161:
        return false
    if {_dy} is not 81:
        return false
    if {_dz} is not 161:
        return false
    return true

# Promoção com backup retido e rollback explícito em falha de rename.
function bridge_setupPromote(candidate: object, target: object, token: text) :: boolean:
    if {_candidate}.isFile() is false:
        return false
    set {_hadOld} to {_target}.exists()
    set {_parent} to {_target}.getParentFile()
    set {_oldName} to {_target}.getName()
    set {_backup} to new File({_parent}, "%{_oldName}%.backup-%{_token}%")
    if {_backup}.exists() is true:
        return false
    if {_hadOld} is true:
        set {_movedOld} to {_target}.renameTo({_backup})
        if {_movedOld} is not true:
            send "[Bridge] Setup: não foi possível preservar a schematic anterior. Cadastro não substituído." to console
            return false
    set {_promoted} to {_candidate}.renameTo({_target})
    if {_promoted} is true:
        return true
    if {_hadOld} is true:
        set {_restored} to {_backup}.renameTo({_target})
        if {_restored} is not true:
            send "[Bridge] ERRO: rollback do arquivo falhou. Backup preservado em %{_backup}%; alvo: %{_target}%. Não recadastre antes de recuperar." to console
    return false


# Contexto volátil: inventário e slots pertencentes a cada abertura do Bridge.
function bridge_menuBind(p: player, inv: object, kind: text, arena: text = "", prop: text = ""):
    set {_u} to {_p}'s uuid
    set {_oldView} to {-bridge::menu::%{_u}%::inventory}
    if {_oldView} is set:
        set {_currentView} to {_p}.getOpenInventory().getTopInventory()
        if {_currentView}.equals({_oldView}) is true:
            close {_p}'s inventory
    if {-bridge::ui_revision::%{_u}%} is not set:
        set {-bridge::ui_revision::%{_u}%} to 0
    add 1 to {-bridge::ui_revision::%{_u}%}
    delete {-bridge::menu::%{_u}%::*}
    delete {bridge::chat_edit::%{_u}%::*}
    set {-bridge::menu::%{_u}%::inventory} to {_inv}
    set {-bridge::menu::%{_u}%::kind} to {_kind}
    set {-bridge::menu::%{_u}%::arena} to {_arena}
    set {-bridge::menu::%{_u}%::prop} to {_prop}
    set {-bridge::menu::%{_u}%::revision} to {-bridge::ui_revision::%{_u}%}

function bridge_configTitle(prop: text) :: text:
    if {_prop} is "gols":
        return "Gols"
    if {_prop} is "tempo":
        return "Tempo"
    if {_prop} is "y-void":
        return "Y-Void"
    if {_prop} is "y-max":
        return "Y-Max"
    if {_prop} is "limite-ponte":
        return "Limite Longitudinal"
    if {_prop} is "limite-lateral":
        return "Limite Lateral"
    return ""

function bridge_configValueValid(prop: text, value: integer) :: boolean:
    if {_prop} is "gols" or "tempo":
        if {_value} > 0:
            return true
    else if {_prop} is "limite-ponte" or "limite-lateral":
        if {_value} >= 0:
            return true
    else if {_prop} is "y-max":
        if {_value} >= 0:
            if {_value} <= 255:
                return true
    else if {_prop} is "y-void":
        # Limiar de void pode ser negativo; não é uma altura de construção.
        if {_value} <= 255:
            return true
    return false

function bridge_configApply(actor: object, arena: text, prop: text, value: integer) :: boolean:
    if Bukkit.isPrimaryThread() is false:
        return false
    if {_actor}.hasPermission("bridge.admin") is false:
        set {_msg} to colored "%{bridge::config::erro}% &cVocê não tem permissão para editar arenas."
        {_actor}.sendMessage({_msg})
        return false
    if {bridge::arenas::*} does not contain {_arena}:
        set {_msg} to colored "%{bridge::config::erro}% &cArena não encontrada."
        {_actor}.sendMessage({_msg})
        return false
    if {-bridge::setup::%{_arena}%::active} is true:
        set {_msg} to colored "%{bridge::config::erro}% &cAguarde o cadastro desta arena terminar antes de editar valores."
        {_actor}.sendMessage({_msg})
        return false
    if bridge_configValueValid({_prop}, {_value}) is not true:
        set {_msg} to colored "%{bridge::config::erro}% &cPropriedade ou valor inválido. Gols/tempo positivos; limites não negativos; Y-Max entre 0 e 255; Y-Void até 255."
        {_actor}.sendMessage({_msg})
        return false
    set {bridge::arena::%{_arena}%::%{_prop}%} to {_value}
    if {_prop} is "tempo":
        set {_msg} to colored "%{bridge::config::sucesso}% &aTempo de &f%{_arena}%&a: &f%{_value}% segundos&a."
    else:
        set {_msg} to colored "%{bridge::config::sucesso}% &a%{_prop}% de &f%{_arena}%&a: &f%{_value}%&a."
    {_actor}.sendMessage({_msg})
    return true

function bridge_menuAction(p: player, slot: integer, click: text):
    set {_u} to {_p}'s uuid
    set {_kind} to {-bridge::menu::%{_u}%::kind}
    if {_kind} is not "ARENAS":
        if {_p}.hasPermission("bridge.admin") is false:
            send "%{bridge::config::erro}% &cVocê não tem permissão para este editor." to {_p}
            stop
    if {_kind} is "ARENAS" or "ADMIN_LIST":
        set {_target} to {-bridge::menu::%{_u}%::slots::%{_slot}%}
        if {_target} is not set:
            stop
        if {bridge::arenas::*} does not contain {_target}:
            send "%{bridge::config::erro}% &cEssa arena não está mais cadastrada. Reabra o menu." to {_p}
            stop
        if {_kind} is "ARENAS":
            close {_p}'s inventory
            make {_p} execute command "/jogar %{_target}%"
        else if {_click} is "RIGHT":
            bridge_openEditor({_p}, {_target})
        else:
            close {_p}'s inventory
            make {_p} execute command "/bridge tp %{_target}% centro"
        stop
    set {_arena} to {-bridge::menu::%{_u}%::arena}
    if {bridge::arenas::*} does not contain {_arena}:
        send "%{bridge::config::erro}% &cArena não encontrada. Reabra o menu." to {_p}
        stop
    if {_kind} is "ADMIN_EDITOR":
        if {_slot} is 31:
            bridge_openMainMenu({_p})
            stop
        if {_slot} is 10:
            set {_prop} to "gols"
        else if {_slot} is 11:
            set {_prop} to "tempo"
        else if {_slot} is 12:
            set {_prop} to "y-void"
        else if {_slot} is 13:
            set {_prop} to "y-max"
        else if {_slot} is 14:
            set {_prop} to "limite-ponte"
        else if {_slot} is 15:
            set {_prop} to "limite-lateral"
        else:
            stop
        set {_value} to {bridge::arena::%{_arena}%::%{_prop}%}
        if {_value} is not set:
            send "%{bridge::config::erro}% &cValor ausente. Configure-o pelo comando /bridge set." to {_p}
            stop
        set {_title} to bridge_configTitle({_prop})
        bridge_openModifier({_p}, {_arena}, {_prop}, {_title}, {_value})
        stop
    if {_kind} is not "ADMIN_VALUE":
        stop
    set {_prop} to {-bridge::menu::%{_u}%::prop}
    set {_title} to bridge_configTitle({_prop})
    if {_title} is "":
        stop
    if {_slot} is 31:
        bridge_openEditor({_p}, {_arena})
        stop
    if {-bridge::setup::%{_arena}%::active} is true:
        send "%{bridge::config::erro}% &cAguarde o cadastro desta arena terminar." to {_p}
        stop
    if {_slot} is 22:
        close {_p}'s inventory
        add 1 to {-bridge::ui_revision::%{_u}%}
        set {bridge::chat_edit::%{_u}%::arena} to {_arena}
        set {bridge::chat_edit::%{_u}%::prop} to {_prop}
        set {bridge::chat_edit::%{_u}%::revision} to {-bridge::ui_revision::%{_u}%}
        if {_prop} is "tempo":
            send "%{bridge::config::prefix}% &eDigite o tempo em minutos, ou cancelar." to {_p}
        else:
            send "%{bridge::config::prefix}% &eDigite um inteiro para %{_prop}%, ou cancelar." to {_p}
        stop
    set {_oldValue} to {bridge::arena::%{_arena}%::%{_prop}%}
    if {_oldValue} is not set:
        stop
    set {_value} to {_oldValue}
    if {_slot} is 24:
        if {_prop} is "y-void" or "y-max":
            set {_value} to floor(y-coordinate of {_p}'s location)
        else if {_prop} is "limite-ponte":
            if {bridge::arena::%{_arena}%::axis} is "X":
                set {_value} to abs(floor(x-coordinate of {_p}'s location))
            else:
                set {_value} to abs(floor(z-coordinate of {_p}'s location))
            if {_value} <= 0:
                send "%{bridge::config::erro}% &cAfaste-se do centro para definir o limite." to {_p}
                stop
        else:
            stop
    else:
        set {_delta} to 0
        if {_slot} is 10:
            set {_delta} to -5
        else if {_slot} is 11:
            set {_delta} to -1
        else if {_slot} is 15:
            set {_delta} to 1
        else if {_slot} is 16:
            set {_delta} to 5
        else:
            stop
        if {_prop} is "tempo":
            set {_delta} to {_delta} * 60
        set {_value} to {_oldValue} + {_delta}
        if {_prop} is "tempo":
            if {_value} < 60:
                set {_value} to 60
    set {_ok} to bridge_configApply({_p}, {_arena}, {_prop}, {_value})
    set {_current} to {bridge::arena::%{_arena}%::%{_prop}%}
    bridge_openModifier({_p}, {_arena}, {_prop}, {_title}, {_current})

on BridgeMenuDragEvent:
    set {_who} to event.getWhoClicked()
    set {_u} to {_who}.getUniqueId()
    set {_inv} to {-bridge::menu::%{_u}%::inventory}
    if {_inv} is set:
        set {_top} to event.getView().getTopInventory()
        if {_top}.equals({_inv}) is true:
            event.setCancelled(true)

on inventory close:
    set {_u} to player's uuid
    set {_inv} to {-bridge::menu::%{_u}%::inventory}
    if {_inv} is set:
        set {_closed} to event.getInventory()
        if {_closed}.equals({_inv}) is true:
            delete {-bridge::menu::%{_u}%::*}

on quit:
    set {_u} to player's uuid
    delete {-bridge::menu::%{_u}%::*}
    delete {-bridge::ui_revision::%{_u}%}
    delete {bridge::chat_edit::%{_u}%::*}

# Migração de interfaces antigas abertas durante reload: fecha somente nomes
# reservados conhecidos e tamanhos esperados; cliques normais usam a referência.
function bridge_legacyMenu(inv: object) :: boolean:
    set {_size} to {_inv}.getSize()
    set {_title} to {_inv}.getTitle()
    if {_size} is 27:
        if {_title} is "§8The Bridge - Seleção de Arenas":
            return true
    if {_size} is not 36:
        return false
    if {_title} is "§8The Bridge - Arenas Cadastradas":
        return true
    loop {bridge::arenas::*}:
        set {_arena} to loop-value
        if {_title} is "§8Gerenciar: %{_arena}%":
            return true
        loop "gols", "tempo", "y-void", "y-max", "limite-ponte" and "limite-lateral":
            set {_name} to bridge_configTitle(loop-value-2)
            if {_title} is "§8Editar: %{_arena}% > %{_name}%":
                return true
    return false

on load:
    wait 1 tick
    loop all players:
        set {_u} to loop-player's uuid
        set {_inv} to loop-player.getOpenInventory().getTopInventory()
        if bridge_legacyMenu({_inv}) is true:
            close loop-player's inventory
            send "%{bridge::config::prefix}% &eOs menus foram atualizados. Reabra o menu para continuar." to loop-player
        delete {-bridge::menu::%{_u}%::*}
        delete {bridge::chat_edit::%{_u}%::*}
