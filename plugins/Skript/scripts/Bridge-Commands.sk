# ================================================================
# THE BRIDGE - AUTOCOMPLETE ISOLADO / skript-reflect 2.2.3
# Descobre comandos dos scripts ativos Bridge-*.sk; não modifica executores.
# Nomes/aliases continuam no commandMap normal do servidor.
# ================================================================
import:
    org.bukkit.Bukkit
    org.bukkit.command.TabCompleter
    ch.njol.skript.command.Commands
    java.util.ArrayList
    java.lang.Class
    java.lang.System
    java.lang.reflect.Array

function bridge_tabMethod0(c: object, methodName: text) :: boolean:
    set {_methods} to {_c}.getMethods()
    set {_count} to Array.getLength({_methods})
    loop {_count} times:
        set {_i} to loop-value - 1
        set {_method} to Array.get({_methods}, {_i})
        if {_method}.getName() is {_methodName}:
            set {_parameters} to {_method}.getParameterTypes()
            if Array.getLength({_parameters}) is 0:
                return true
    return false

function bridge_tabProvide(list: object, token: text, sender: object):
    if {_token} is "@arenas":
        loop {bridge::arenas::*}:
            {_list}.add("%loop-value%")
    else if {_token} is "@instances":
        loop {bridge::arenas::*}:
            set {_arena} to loop-value
            loop {bridge::arena::%{_arena}%::instances::*}:
                {_list}.add("%loop-value-2%")
    else if {_token} is "@footer":
        set {_footer} to {bridge::config::scoreboard_footer}
        if {_footer} is set:
            {_list}.add({_footer})
    else if {_token} is "@players":
        loop all players:
            set {_visible} to true
            if {_sender} is a player:
                if {_sender}.canSee(loop-player) is false:
                    set {_visible} to false
            if {_visible} is true:
                {_list}.add(name of loop-player)
    else:
        # Tokens desconhecidos não viram sugestão acidental.
        if {_token} does not start with "@":
            {_list}.add({_token})

function bridge_tabComplete(proxy: object, sender: object, cmd: object, label: text, args: object) :: object:
    set {_result} to new ArrayList()
    # Não mover consultas de Bukkit para thread assíncrona.
    if Bukkit.isPrimaryThread() is false:
        return {_result}
    if {_cmd}.testPermissionSilent({_sender}) is false:
        return {_result}
    if {_args} is not set:
        return {_result}
    set {_n} to Array.getLength({_args})
    if {_n} <= 0:
        return {_result}
    set {_last} to {_n} - 1
    set {_prefix} to Array.get({_args}, {_last})
    set {_prefix} to {_prefix}.toLowerCase()
    set {_root} to {_cmd}.getName()
    set {_root} to {_root}.toLowerCase()
    set {_a1} to Array.get({_args}, 0)
    set {_a1} to {_a1}.toLowerCase()
    set {_custom} to false
    set {_tokens} to new ArrayList()
    if {_root} is "bridge":
        set {_custom} to true
        if {_n} is 1:
            set {_choices::*} to "setuparena", "setlimitpos", "setcage", "setlimit", "set", "tp", "menu", "list" and "maps"
        else if {_n} is 2:
            if {_a1} is "setlimitpos" or "setcage" or "setlimit" or "set" or "tp":
                set {_choices::1} to "@arenas"
        else if {_n} is 3:
            if {_a1} is "setcage":
                set {_choices::*} to "1" and "2"
            else if {_a1} is "setlimit":
                set {_choices::*} to "ponte" and "lateral"
            else if {_a1} is "set":
                set {_choices::*} to "gols", "tempo", "y-void", "y-max", "limite-ponte" and "limite-lateral"
            else if {_a1} is "tp":
                set {_choices::*} to "centro", "t1" and "t2"
        else if {_n} is 4:
            if {_a1} is "set" or "setlimit":
                set {_arena} to Array.get({_args}, 1)
                set {_property} to Array.get({_args}, 2)
                if {_a1} is "setlimit":
                    if {_property} is "ponte" or "longitudinal":
                        set {_property} to "limite-ponte"
                    else if {_property} is "lateral":
                        set {_property} to "limite-lateral"
                set {_value} to {bridge::arena::%{_arena}%::%{_property}%}
                if {_value} is set:
                    set {_choices::1} to "%{_value}%"
    else if {_root} is "jogar":
        if {_n} is 1:
            set {_custom} to true
            set {_choices::1} to "@arenas"
    else if {_root} is "bridgereset":
        if {_n} is 1:
            set {_custom} to true
            set {_choices::1} to "@instances"
    else if {_root} is "bridgevote":
        if {_n} is 1:
            set {_custom} to true
            set {_choices::*} to "sim" and "nao"
    else if {_root} is "bridgescoreboard":
        if {_n} is 1:
            set {_custom} to true
            set {_choices::1} to "setfooter"
        else if {_n} is 2:
            if {_a1} is "setfooter":
                set {_custom} to true
                set {_choices::1} to "@footer"
    # Extensão central OPCIONAL: comando principal e posição 1-based do argumento.
    # Ex.: {bridge::tab::custom::novocomando::1::*} = "opcao", "@arenas".
    # Não é preciso recadastrar aliases nem tocar nos outros comandos.
    if {bridge::tab::custom::%{_root}%::%{_n}%::*} is set:
        set {_custom} to true
        set {_choices::*} to {bridge::tab::custom::%{_root}%::%{_n}%::*}
    if {_custom} is not true:
        set {_id} to System.identityHashCode({_cmd})
        set {_previous} to {-bridge::tab::previous::%{_id}%}
        if {_previous} is set:
            return {_previous}.onTabComplete({_sender}, {_cmd}, {_label}, {_args})
        # Mantém o completador nativo para tipos conhecidos e comandos novos.
        set {_executor} to {_cmd}.getExecutor()
        if {_executor} is set:
            if {_executor}.getClass().getName() is "ch.njol.skript.command.ScriptCommand":
                return {_executor}.onTabComplete({_sender}, {_cmd}, {_label}, {_args})
        return {_result}
    loop {_choices::*}:
        bridge_tabProvide({_tokens}, "%loop-value%", {_sender})
    set {_iterator} to {_tokens}.iterator()
    while {_iterator}.hasNext() is true:
        set {_candidate} to {_iterator}.next()
        set {_lower} to {_candidate}.toLowerCase()
        if {_lower}.startsWith({_prefix}) is true:
            if {_result}.contains({_candidate}) is false:
                {_result}.add({_candidate})
    return {_result}

function bridge_tabRestore(cmd: object, id: text):
    if {-bridge::tab::proxy} is set:
        set {_current} to {_cmd}.getTabCompleter()
        set {_currentID} to 0
        if {_current} is set:
            set {_currentID} to System.identityHashCode({_current})
        set {_ours} to System.identityHashCode({-bridge::tab::proxy})
        if {_currentID} is {_ours}:
            set {_old} to {-bridge::tab::previous::%{_id}%}
            if {_old} is set:
                {_cmd}.setTabCompleter({_old})
            else:
                {_cmd}.setTabCompleter(null)
    delete {-bridge::tab::previous::%{_id}%}
    delete {-bridge::tab::commands::%{_id}%}

function bridge_tabScan(report: boolean):
    if {-bridge::tab::disabled} is true:
        stop
    if {-bridge::tab::proxy} is not set:
        stop
    set {_map} to Commands.getCommandMap()
    if {_map} is not set:
        send "[Bridge] TAB: commandMap do Skript indisponível. Módulo desativado sem alterar executores." to console
        set {-bridge::tab::disabled} to true
        stop
    set {_commands} to {_map}.getCommands()
    set {_iterator} to {_commands}.iterator()
    set {_found} to 0
    set {_installed} to 0
    while {_iterator}.hasNext() is true:
        set {_cmd} to {_iterator}.next()
        if {_cmd}.getClass().getName() is "org.bukkit.command.PluginCommand":
            if {_cmd}.getPlugin().getName() is "Skript":
                set {_executor} to {_cmd}.getExecutor()
                if {_executor} is set:
                    if {_executor}.getClass().getName() is "ch.njol.skript.command.ScriptCommand":
                        if {-bridge::tab::scriptApiChecked} is not true:
                            set {_class} to {_executor}.getClass()
                            if bridge_tabMethod0({_class}, "getScript") is not true:
                                send "[Bridge] TAB: este fork do Skript não expõe ScriptCommand.getScript(). Integração desativada; outros módulos permanecem independentes." to console
                                set {-bridge::tab::disabled} to true
                                stop
                            set {-bridge::tab::scriptApiChecked} to true
                        set {_script} to {_executor}.getScript()
                        if {_script} is set:
                            set {_name} to {_script}.getName()
                            set {_name} to {_name}.toLowerCase()
                            if {_name}.startsWith("bridge-") is true:
                                if {_name}.endsWith(".sk") is true:
                                    set {_idNumber} to System.identityHashCode({_cmd})
                                    set {_id} to "%{_idNumber}%"
                                    if {_live::%{_id}%} is not true:
                                        set {_live::%{_id}%} to true
                                        add 1 to {_found}
                                    if {-bridge::tab::commands::%{_id}%} is not set:
                                        set {_previous} to {_cmd}.getTabCompleter()
                                        set {-bridge::tab::previous::%{_id}%} to {_previous}
                                        set {-bridge::tab::commands::%{_id}%} to {_cmd}
                                        {_cmd}.setTabCompleter({-bridge::tab::proxy})
                                        add 1 to {_installed}
    # Descarregamentos/reloads não acumulam referências a comandos antigos.
    loop {-bridge::tab::commands::*}:
        set {_id} to loop-index
        if {_live::%{_id}%} is not true:
            set {_stale::%{_id}%} to loop-value
    loop {_stale::*}:
        bridge_tabRestore(loop-value, loop-index)
    if {_report} is true:
        send "[Bridge] TAB: %{_found}% comando(s) principal(is) do projeto encontrado(s); %{_installed}% integração(ões) aplicada(s). Teste TAB ingame; reload sozinho não valida a execução." to console

on load:
    delete {-bridge::tab::*}
    set {_class} to Class.forName("ch.njol.skript.command.Commands")
    if bridge_tabMethod0({_class}, "getCommandMap") is not true:
        send "[Bridge] TAB: Commands.getCommandMap() não existe neste fork. Nenhum comando foi alterado." to console
        set {-bridge::tab::disabled} to true
        stop
    set {_callbacks::ontabcomplete} to function reference "bridge_tabComplete"
    set {-bridge::tab::proxy} to new proxy instance of TabCompleter using {_callbacks::*}
    wait 2 ticks
    bridge_tabScan(true)

every 5 seconds:
    # Descobre comandos novos ou recarregados e reaproveita os aliases do mesmo objeto.
    bridge_tabScan(false)

on unload:
    loop {-bridge::tab::commands::*}:
        set {_id} to loop-index
        set {_restore::%{_id}%} to loop-value
    loop {_restore::*}:
        bridge_tabRestore(loop-value, loop-index)
    delete {-bridge::tab::*}
